<Window x:Class="AIControlTower.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="clr-namespace:AIControlTower.Models" Title="Control Tower · 통합 작업실" Width="1420" Height="900" MinWidth="1060" MinHeight="720" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="ProjectFolder_Drop">
 <Window.Resources>
  <Style x:Key="StatusBadge" TargetType="Border"><Setter Property="Background" Value="#222A25"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="8,5"/><Setter Property="HorizontalAlignment" Value="Left"/><Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="{x:Static models:StatusKind.Running}"><Setter Property="Background" Value="#233A2A"/></DataTrigger><DataTrigger Binding="{Binding Kind}" Value="{x:Static models:StatusKind.Ready}"><Setter Property="Background" Value="#233A2A"/></DataTrigger><DataTrigger Binding="{Binding Kind}" Value="{x:Static models:StatusKind.Error}"><Setter Property="Background" Value="#402A24"/></DataTrigger><DataTrigger Binding="{Binding Kind}" Value="{x:Static models:StatusKind.NotConfigured}"><Setter Property="Background" Value="#393222"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="StatusText" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="FontSize" Value="12"/><Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="{x:Static models:StatusKind.Running}"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></DataTrigger><DataTrigger Binding="{Binding Kind}" Value="{x:Static models:StatusKind.Ready}"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></DataTrigger><DataTrigger Binding="{Binding Kind}" Value="{x:Static models:StatusKind.Error}"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="3"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
  <Border Background="{StaticResource AccentBrush}"/>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource RailBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
    <Grid Margin="16,24,16,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="8,0,0,24"><TextBlock Text="CONTROL / TOWER" FontSize="10" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/><TextBlock Text="통합 작업실" FontSize="23" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="프로젝트에서 실행까지." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/></StackPanel>
     <Grid Grid.Row="1" Margin="8,0,8,10"><TextBlock Text="프로젝트" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding ProjectsCount}" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="11"/></Grid>
     <Grid Grid.Row="2">
      <ListBox x:Name="ProjectList" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject, Mode=TwoWay}" SelectionChanged="Projects_SelectionChanged" AutomationProperties.Name="프로젝트 목록">
       <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Text="아래에서 프로젝트 폴더를&#10;선택해 작업실을 시작하세요." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="12,18"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ProjectsCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </Grid>
     <StackPanel Grid.Row="3" Margin="0,16,0,0"><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="8,16,8,10"><TextBlock Text="프로젝트 보관 폴더" Style="{StaticResource Eyebrow}"/></Border><TextBox Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="프로젝트 폴더를 모아두는 위치" AutomationProperties.Name="프로젝트 보관 폴더 경로" FontSize="11"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="폴더 선택" Click="ChooseRoot_Click" Padding="8,8" FontSize="12"/><Button Grid.Column="2" Content="찾아보기" Click="Discover_Click" Padding="8,8" FontSize="12"/></Grid><TextBlock Text="폴더를 이 창에 끌어놓아도 됩니다." FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="4,10,0,0" TextWrapping="Wrap"/></StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Column="1" Margin="28,24,28,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="WORKSPACE" Style="{StaticResource Eyebrow}"/><TextBlock Text="전체 흐름을 한곳에서" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="새로고침" Click="Refresh_Click" Style="{StaticResource QuietButton}" Margin="0,0,8,0"/><Button Content="Jev 작업" Click="Jev_Click" Style="{StaticResource QuietButton}"/></StackPanel></Grid>
    <Grid Grid.Row="1" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="프로젝트  " Foreground="{StaticResource MutedBrush}" FontSize="12"/><TextBlock Text="{Binding ProjectsCount}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="   /   프로그램  " Foreground="{StaticResource MutedBrush}" FontSize="12"/><TextBlock Text="{Binding ProgramsCount}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="   /   실행 중  " Foreground="{StaticResource MutedBrush}" FontSize="12"/><TextBlock Text="{Binding RunningCount}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12"/></StackPanel><CheckBox Grid.Column="1" Content="동작 효과 줄이기" IsChecked="{Binding ReduceMotion, Mode=TwoWay}" FontSize="11" Margin="8,-4,0,0"/></Grid>
    <TabControl Grid.Row="2" x:Name="WorkspaceTabs" SelectionChanged="WorkspaceTabs_SelectionChanged">
     <TabItem Header="프로젝트 작업실">
      <Grid x:Name="WorkspaceContent" Margin="0,20,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding SelectedProject.Name, TargetNullValue=프로젝트를 선택하세요}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedProject.Path}" Foreground="{StaticResource MutedBrush}" FontSize="11" FontFamily="Consolas, Malgun Gothic" Margin="0,7,8,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedProject.Path}"/></StackPanel><Button Grid.Column="1" Content="프로젝트 폴더 열기" Click="OpenProject_Click" VerticalAlignment="Center" Style="{StaticResource QuietButton}"/></Grid>
       <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="270"/><ColumnDefinition Width="24"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,12"><Grid><TextBlock Text="기능 / 프로그램" Style="{StaticResource Eyebrow}"/><TextBlock Text="선택해 열기·실행" FontSize="10" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/></Grid></Border><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding SelectedProject.Functions}"><ItemsControl.ItemTemplate><DataTemplate><Expander Header="{Binding Name}" Margin="0,0,0,8"><ListBox ItemsSource="{Binding Programs}" SelectionChanged="Programs_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="프로그램 목록"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Data="M 0 0 L 0 10 L 8 5 Z" Fill="{StaticResource MutedBrush}" Width="8" Height="10" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,3,0,0"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,6,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="8,3,0,0"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Expander></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
         <TextBlock Grid.Row="1" Text="프로젝트에 포함된 기능과 프로그램이&#10;이 영역에 표시됩니다." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,24,0,0" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedProject}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        </Grid>
        <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="20" CornerRadius="6"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ProgramInspector"><TextBlock Text="PROGRAM / CONTROL" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding SelectedProgram.Name, TargetNullValue=프로그램을 선택하세요}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,14,0,8"/><TextBlock Text="{Binding SelectedProgram.Kind}" Foreground="{StaticResource AccentBrush}" FontSize="11"/><TextBlock Text="{Binding SelectedProgram.Detail}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,14,0,16"/><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0"><StackPanel><TextBlock Text="현재 상태" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding SelectedProgram.Status, TargetNullValue=선택 대기}" Margin="0,8,0,0"/><TextBlock Text="위치" Style="{StaticResource Eyebrow}" Margin="0,16,0,0"/><TextBlock Text="{Binding SelectedProgram.Path}" Foreground="{StaticResource MutedBrush}" FontFamily="Consolas, Malgun Gothic" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,18"/></StackPanel></Border><TextBlock Text="실행할 명령" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/><ComboBox ItemsSource="{Binding SelectedProgram.Commands}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedCommand, Mode=TwoWay}" Margin="0,0,0,10" AutomationProperties.Name="실행할 프로그램 명령"/><Button Content="프로그램 실행" Click="LaunchProgram_Click" IsEnabled="{Binding SelectedProgram.CanLaunch, FallbackValue=False, TargetNullValue=False}" Style="{StaticResource PrimaryButton}"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="위치 열기" Click="OpenProgram_Click" Padding="8,9" Style="{StaticResource QuietButton}"/><Button Grid.Column="2" Content="중지" Click="StopProgram_Click" IsEnabled="{Binding CanStopSelectedProgram, FallbackValue=False}" Padding="8,9" Style="{StaticResource QuietButton}" Foreground="{StaticResource DangerBrush}"/></Grid><TextBlock Text="선택한 프로그램의 동작과 결과는&#10;아래 실행 기록에서 확인하세요." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,18,0,0"/></StackPanel></ScrollViewer></Border>
       </Grid>
      </Grid>
     </TabItem>
     <TabItem Header="도구 연결 상태"><Grid Margin="0,20,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,20"><TextBlock Text="실행 환경" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="설치·로그인·실행 여부를 실제 확인 결과와 함께 표시합니다." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/><WrapPanel Margin="0,16,0,0"><Button Content="공유 연결 확인 / 시작" Click="EnsureRemote_Click" Style="{StaticResource QuietButton}" Margin="0,0,8,0"/><Button Content="시작 등록 하나로 통합" Click="ConsolidateRemote_Click" Style="{StaticResource QuietButton}"/></WrapPanel></StackPanel><DataGrid Grid.Row="1" ItemsSource="{Binding Statuses}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="도구" Binding="{Binding DisplayName}" Width="155"/><DataGridTemplateColumn Header="상태" Width="115"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Style="{StaticResource StatusBadge}"><TextBlock Text="{Binding State}" Style="{StaticResource StatusText}"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="확인 근거" Binding="{Binding Detail}" Width="*"/><DataGridTextColumn Header="확인 시각" Binding="{Binding CheckedAt}" Width="86"/></DataGrid.Columns></DataGrid></Grid></TabItem>
     <TabItem Header="설정 및 복구"><ScrollViewer Margin="0,20,0,0" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="640" HorizontalAlignment="Left"><TextBlock Text="작업실 관리" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="관제탑의 설치와 기존 시작 구성을 관리합니다." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,24"/><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,1" Padding="0,18"><StackPanel><TextBlock Text="관제탑 설치" FontWeight="SemiBold"/><TextBlock Text="현재 실행 파일을 설치하고 사용자 자동 시작에 등록합니다." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,14"/><StackPanel Orientation="Horizontal"><Button Content="설치 / 업데이트" Click="Install_Click"/><Button Content="자동 시작 및 설치 제거" Click="Uninstall_Click" Style="{StaticResource QuietButton}" Foreground="{StaticResource DangerBrush}" Margin="8,0,0,0"/></StackPanel></StackPanel></Border><StackPanel Margin="0,20,0,0"><TextBlock Text="Desktop Commander 복구" FontWeight="SemiBold"/><TextBlock Text="관제탑이 보관한 백업을 사용해 이전 시작 파일을 복구합니다." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,14"/><Button Content="시작 구성 복구" Click="Restore_Click" HorizontalAlignment="Left" Style="{StaticResource QuietButton}"/></StackPanel><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,24,0,0" Padding="0,20,0,0"><StackPanel><TextBlock Text="Jev 실행" FontWeight="SemiBold"/><CheckBox Content="이 작업실에서 Jev 실행 사용" IsChecked="{Binding EnableJev, Mode=TwoWay}" Margin="0,10,0,0"/><TextBlock Text="{Binding LocalJevPolicyMessage}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,14"/><Button Content="Jev 작업 창 열기" Click="Jev_Click" HorizontalAlignment="Left" Style="{StaticResource QuietButton}"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <Border Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="0,16,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="145"/></Grid.RowDefinitions><Grid Margin="0,0,0,10"><TextBlock Text="실행 기록" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding ActivitySummary}" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="480"/></Grid><Border Grid.Row="1" Background="{StaticResource RailBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="10"><Grid><ListBox x:Name="LogList" ItemsSource="{Binding JobLogs}" FontFamily="Consolas, Malgun Gothic" FontSize="11" ScrollViewer.HorizontalScrollBarVisibility="Auto"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Padding" Value="3,3"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle></ListBox><TextBlock Text="실행하면 여기에 기록이 쌓입니다." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="5,5"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding JobLogs.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border></Grid></Border>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="{StaticResource RailBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,7"><Grid><TextBlock Text="{Binding Message}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,110,0"/><TextBlock Text="LOCAL WORKSPACE" Foreground="{StaticResource MutedBrush}" FontSize="9" HorizontalAlignment="Right"/></Grid></Border>
 </Grid>
</Window>
