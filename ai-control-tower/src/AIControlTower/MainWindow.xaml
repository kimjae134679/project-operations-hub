<Window x:Class="AIControlTower.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AIControlTower"
        Title="AI Control Tower" Height="760" Width="1120" MinHeight="620" MinWidth="900"
        Background="#111827" Foreground="#F9FAFB" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Padding" Value="14,7"/>
            <Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Margin" Value="0,5,0,12"/><Setter Property="Padding" Value="8"/><Setter Property="Background" Value="#1F2937"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#4B5563"/></Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,18">
            <TextBlock Text="AI Control Tower" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="로컬 AI 도구 상태와 Jev 작업을 실제 확인 결과로 관리합니다." Foreground="#9CA3AF" Margin="0,4,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Grid.Column="0" Background="#1F2937" CornerRadius="8" Padding="14" Margin="0,0,16,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="도구 상태" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Content="지금 갱신" Click="Refresh_Click" Margin="18,0,0,0"/>
                    <TextBlock Text="{Binding Message}" Foreground="#93C5FD" VerticalAlignment="Center"/>
                </StackPanel>
                <DataGrid ItemsSource="{Binding Statuses}" AutoGenerateColumns="False" IsReadOnly="True" Background="#111827" Foreground="#F9FAFB" BorderThickness="0" GridLinesVisibility="Horizontal" CanUserAddRows="False"><DataGrid.Resources><Style TargetType="DataGridCell"><Setter Property="Background" Value="#111827"/><Setter Property="Foreground" Value="#F9FAFB"/><Setter Property="BorderBrush" Value="#374151"/></Style><Style TargetType="DataGridRow"><Setter Property="Background" Value="#111827"/><Setter Property="Foreground" Value="#F9FAFB"/></Style><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#374151"/><Setter Property="Foreground" Value="#F9FAFB"/></Style></DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="도구" Binding="{Binding DisplayName}" Width="150"/>
                        <DataGridTextColumn Header="상태" Binding="{Binding State}" Width="110"/>
                        <DataGridTextColumn Header="설명" Binding="{Binding Detail}" Width="*"/>
                        <DataGridTextColumn Header="확인" Binding="{Binding CheckedAt}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="#1F2937" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Jev 작업" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="프로젝트 경로" Margin="0,14,0,0" Foreground="#D1D5DB"/>
                        <TextBox Text="{Binding ProjectPath, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="작업 내용" Foreground="#D1D5DB"/>
                        <TextBox Text="{Binding TaskInput, UpdateSourceTrigger=PropertyChanged}" Height="80" AcceptsReturn="True" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal"><Button Content="Jev 작업 실행" Click="RunJev_Click"/><Button Content="작업 취소" Background="#B91C1C" Click="CancelJev_Click"/></StackPanel>
                        <TextBlock Text="{Binding ActivitySummary}" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#1F2937" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="설치 및 복구" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="설치는 publish된 EXE를 사용하며, 기존 Desktop Commander 시작 파일은 백업 후에만 변경됩니다." TextWrapping="Wrap" Foreground="#D1D5DB" Margin="0,10,0,12"/>
                        <StackPanel Orientation="Horizontal"><Button Content="설치" Click="Install_Click"/><Button Content="제거" Background="#B91C1C" Click="Uninstall_Click"/><Button Content="Desktop Commander 복구" Background="#7C3AED" Click="Restore_Click"/></StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="0,18,0,0" Foreground="#9CA3AF" Text="비밀번호, API 키, 토큰 값은 화면과 로그에 표시하지 않습니다. 확인할 수 없는 상태는 Unknown으로 표시합니다."/>
    </Grid>
</Window>


