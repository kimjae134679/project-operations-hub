<Window x:Class="AIControlTower.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:services="clr-namespace:AIControlTower.Services" Style="{StaticResource {x:Type Window}}" Title="내 프로젝트 · 컨트롤타워" Width="1460" Height="920" MinWidth="1060" MinHeight="720" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="ProjectFolder_Drop">
 <Window.Resources>

  <Style x:Key="ProjectRow" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
   <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}"/><Setter Property="Padding" Value="13,13"/><Setter Property="Margin" Value="1,2,1,9"/><Setter Property="Foreground" Value="{DynamicResource RailTextBrush}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Grid><Border x:Name="BackSheet" Background="{DynamicResource RailEdgeBrush}" CornerRadius="13" Margin="6,7,6,-3" Visibility="Collapsed"/>
     <Border x:Name="Tile" Background="Transparent" CornerRadius="13" Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="1"><ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/></Border>
     <Border x:Name="Focus" BorderBrush="{DynamicResource BadgeBrush}" BorderThickness="2" CornerRadius="15" Margin="-1" IsHitTestVisible="False" Visibility="Collapsed"/>
    </Grid><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource RailHoverBrush}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource RailSelectedBrush}"/><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource RailEdgeBrush}"/><Setter TargetName="BackSheet" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Focus" Property="Visibility" Value="Visible"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ProjectBadge" TargetType="Border"><Setter Property="Background" Value="{DynamicResource BadgeBrush}"/></Style>
  <Style x:Key="ProgramRow" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
   <Setter Property="Padding" Value="18,20,18,18"/><Setter Property="Margin" Value="1,5,2,8"/><Setter Property="MinHeight" Value="152"/><Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Grid x:Name="WorkCard">
    <Border x:Name="BackCard" Background="{DynamicResource SheetBackBrush}" CornerRadius="18" Margin="8,7,2,-2"/>
    <Border x:Name="MiddleCard" Background="{DynamicResource SheetMiddleBrush}" CornerRadius="18" Margin="4,3,4,0"/>
    <Border x:Name="FrontCard" Background="{DynamicResource CardFace}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="18" Margin="0,0,8,4">
     <Grid><Border Background="{DynamicResource HighlightBrush}" Height="2" CornerRadius="1" Margin="17,1,17,0" VerticalAlignment="Top"/><ContentPresenter Margin="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}"/></Grid>
    </Border>
    <Border x:Name="SelectedLabel" Background="{DynamicResource ActionFace}" CornerRadius="0,0,9,9" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,23,0" Padding="9,3" Visibility="Collapsed"><TextBlock Text="선택" Foreground="{DynamicResource AccentInkBrush}" FontSize="10" FontWeight="SemiBold"/></Border>
    <Border x:Name="CardFocus" BorderBrush="{DynamicResource FocusBrush}" BorderThickness="2" CornerRadius="20" Margin="-2,-2,6,2" Visibility="Collapsed" IsHitTestVisible="False"/>
   </Grid><ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FrontCard" Property="Background" Value="{DynamicResource HoverBrush}"/><Setter TargetName="FrontCard" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter TargetName="FrontCard" Property="Background" Value="{DynamicResource SelectionFace}"/><Setter TargetName="FrontCard" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="SelectedLabel" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="CardFocus" Property="Visibility" Value="Visible"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid x:Name="ContentShell" Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="PageHeader" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="30" Height="30" CornerRadius="7" Background="{DynamicResource ActionFace}" BorderBrush="{DynamicResource RimBrush}" BorderThickness="1" Margin="0,0,10,0"><Path Data="M 0 0 L 12 0 L 12 5 L 0 5 Z M 0 8 L 5 8 L 5 19 L 0 19 Z M 8 8 L 12 8 L 12 19 L 8 19 Z" Fill="{DynamicResource AccentInkBrush}" Width="12" Height="19" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="PageTitle" Text="컨트롤타워" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="ThemeSwitch" Content="{Binding ThemeSwitchLabel}" Click="Theme_Click" Margin="0,0,12,0" AutomationProperties.Name="밝은 화면과 어두운 화면 전환"/><Button Content="프로젝트 폴더 선택" Click="ChooseRoot_Click" ToolTip="프로젝트가 들어 있는 상위 폴더를 선택합니다. 폴더를 이 창으로 끌어와도 됩니다." Margin="0,0,8,0"/><Button Content="새로고침" Click="Discover_Click" Margin="0,0,8,0"/><Button Content="지금 동기화" Click="CommunicationSync_Click" ToolTip="{Binding CentralSyncMessage}"/></StackPanel>
  </Grid>
  <TabControl x:Name="WorkspaceTabs" Grid.Row="1" SelectionChanged="WorkspaceTabs_SelectionChanged">
   <TabItem Header="내 프로젝트">
    <Grid x:Name="WorkspaceContent" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition x:Name="CatalogColumn" Width="238"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border x:Name="ProjectRail" Background="{DynamicResource RailMaterial}" CornerRadius="22" Padding="14,20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Margin="5,0,5,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="내 프로젝트" Foreground="{DynamicResource RailTextBrush}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="만들고 있는 것들" Foreground="{DynamicResource RailMutedBrush}" FontSize="12" Margin="0,5,0,0"/></StackPanel><Border Grid.Column="1" Background="{DynamicResource RailSelectedBrush}" CornerRadius="11" Padding="10,6" VerticalAlignment="Center"><TextBlock Text="{Binding ProjectsCount}" Foreground="{DynamicResource RailTextBrush}" FontWeight="SemiBold"/></Border></Grid>
      <Grid Grid.Row="1" Margin="0,0,0,14"><TextBox x:Name="ProjectSearchBox" Style="{StaticResource SearchBox}" Tag="프로젝트 찾기" Text="{Binding ProjectSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="프로젝트 찾기"/><TextBlock Text="프로젝트 찾기" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource MutedBrush}" FontSize="14" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ProjectSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
      <Grid Grid.Row="2"><ListBox ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" x:Name="ProjectList" ItemsSource="{Binding FilteredProjects}" SelectedItem="{Binding SelectedProject, Mode=TwoWay}" SelectionChanged="Projects_SelectionChanged" ItemContainerStyle="{StaticResource ProjectRow}" Padding="0,0,6,0" AutomationProperties.Name="내 프로젝트"><ListBox.ItemTemplate><DataTemplate>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource ProjectBadge}" Width="32" Height="36" CornerRadius="9" VerticalAlignment="Top"><TextBlock Text="{Binding Monogram}" Foreground="{DynamicResource BadgeInkBrush}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource RailTextBrush}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="40" LineHeight="20" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/><TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource RailMutedBrush}" TextWrapping="Wrap" MaxHeight="34" LineHeight="17" TextTrimming="CharacterEllipsis" Margin="0,7,0,0"/><TextBlock Text="{Binding RoleLabel}" FontSize="11" Foreground="{DynamicResource RailMutedBrush}" Margin="0,8,0,0"/></StackPanel></Grid>
      </DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="검색 결과가 없습니다." Foreground="{DynamicResource RailMutedBrush}" Margin="14,18" Visibility="{Binding NoProjectSearchResults, Converter={StaticResource BoolVisibility}}"/></Grid>
     </Grid></Border>
     <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

      <Border x:Name="ProjectHeader" Padding="24" Margin="0,0,0,18">
       <Grid>
        <Border Background="{DynamicResource SheetBackBrush}" CornerRadius="24" Margin="-8,10,-18,-15" IsHitTestVisible="False"/>
        <Border Background="{DynamicResource SheetMiddleBrush}" CornerRadius="24" Margin="-16,2,-11,-8" IsHitTestVisible="False"/>
        <Border Background="{DynamicResource HeroFace}" BorderBrush="{DynamicResource RimBrush}" BorderThickness="1" CornerRadius="24" Margin="-24,-16,-6,0" IsHitTestVisible="False"/>
        <Grid x:Name="ProjectHeaderBody" Margin="0,0,7,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <StackPanel><TextBlock x:Name="ProjectCategory" Text="{Binding SelectedProject.CategoryLabel}" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/><TextBlock x:Name="ProjectTitle" Text="{Binding SelectedProject.DisplayName,TargetNullValue=프로젝트를 선택하세요}" FontSize="32" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedProject.DisplayName}" Margin="0,0,14,0"/></StackPanel>
         <Button Grid.Column="1" Content="폴더 보기" Click="OpenProject_Click" VerticalAlignment="Center" AutomationProperties.Name="프로젝트 폴더 보기"/>
         <TextBlock x:Name="ProjectDescription" Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding SelectedProject.Description}" Foreground="{DynamicResource MutedBrush}" FontSize="14" TextWrapping="Wrap" MaxHeight="44" TextTrimming="CharacterEllipsis" Margin="0,12,0,0"/>
         <Expander x:Name="ProjectPathLine" Grid.Row="2" Grid.ColumnSpan="2" IsExpanded="False" Header="폴더 위치" Margin="0,8,0,0"><TextBlock Text="{Binding SelectedProject.Path}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/></Expander>
        </Grid>
       </Grid>
      </Border>
      <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition x:Name="InspectorColumn" Width="258"/></Grid.ColumnDefinitions>
       <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,8"><TextBox x:Name="ProgramSearchBox" Style="{StaticResource SearchBox}" Tag="프로그램 · 자료 찾기" Text="{Binding ProgramSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="프로그램 찾기"/><TextBlock Text="프로그램·자료 찾기" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource MutedBrush}" FontSize="14" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ProgramSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
        <Grid Grid.Row="1"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding FilteredFunctions}"><ItemsControl.ItemTemplate><DataTemplate><Expander Margin="0,0,0,6"><Expander.Style><Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}"><Setter Property="IsExpanded" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding IsAdvanced}" Value="True"><Setter Property="IsExpanded" Value="False"/></DataTrigger></Style.Triggers></Style></Expander.Style><Expander.Header><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/></Expander.Header><ListBox ItemsSource="{Binding Programs}" SelectedItem="{Binding DataContext.SelectedProgram, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" SelectionChanged="Programs_SelectionChanged" ItemContainerStyle="{StaticResource ProgramRow}" ScrollViewer.VerticalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><services:ResponsiveCardPanel MinimumCardWidth="260" Gap="12"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="{DynamicResource ChipBrush}" CornerRadius="8" Padding="7,5" HorizontalAlignment="Left"><TextBlock Text="{Binding KindLabel}" FontSize="11" Foreground="{DynamicResource ChipInkBrush}"/></Border><TextBlock Grid.Column="1" Text="{Binding StatusLabel}" Foreground="{DynamicResource AccentBrush}" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/></Grid><TextBlock Grid.Row="1" Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" ToolTip="{Binding DisplayName}" Margin="0,14,0,0"/><TextBlock Grid.Row="2" Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" MaxHeight="40" LineHeight="18" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Expander></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><TextBlock Text="검색 결과가 없습니다." Foreground="{DynamicResource MutedBrush}" Margin="12,18" Visibility="{Binding NoProgramSearchResults, Converter={StaticResource BoolVisibility}}"/></Grid>
       </Grid>
       <Border x:Name="ProgramInspector" Grid.Column="2" Background="{DynamicResource CardFace}" BorderBrush="{DynamicResource RimBrush}" BorderThickness="1" CornerRadius="22" Padding="20">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="InspectorMetadataRow" Height="*" MinHeight="0"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <StackPanel><TextBlock x:Name="InspectorType" Text="{Binding SelectedProgram.KindLabel, TargetNullValue=프로그램 · 자료}" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="InspectorTitle" Text="{Binding SelectedProgram.DisplayName, TargetNullValue=목록에서 선택하세요}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip="{Binding SelectedProgram.DisplayName}" Margin="0,7,0,0"/><TextBlock x:Name="InspectorStatus" Text="{Binding SelectedProgram.StatusLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,8,0,0"/></StackPanel>
         <ScrollViewer x:Name="InspectorMetadata" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,16,0,14"><StackPanel><TextBlock Text="선택한 항목" Style="{StaticResource Eyebrow}" Margin="0,0,0,7"/><TextBlock Text="{Binding SelectedProgram.Description}" TextWrapping="Wrap" FontSize="14" LineHeight="22"/><Expander Header="파일 위치" IsExpanded="False" Margin="0,12,0,0"><TextBlock Text="{Binding SelectedProgram.Path}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/></Expander></StackPanel></ScrollViewer>
         <StackPanel x:Name="InspectorActions" Grid.Row="2" Margin="0,16,0,0"><TextBlock x:Name="InspectorActionLabel" Text="작업 선택" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/><ComboBox x:Name="CommandSelector" ItemsSource="{Binding SelectedProgram.Commands}" SelectedItem="{Binding SelectedCommand, Mode=TwoWay}" IsEnabled="{Binding CanLaunchSelectedProgram}" Visibility="{Binding HasSelectedCommands, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="실행할 작업" Margin="0,0,0,8"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button x:Name="LaunchProgramButton" Content="{Binding SelectedProgram.ActionLabel, TargetNullValue=작업 실행}" Click="LaunchProgram_Click" IsEnabled="{Binding CanLaunchSelectedProgram}" Style="{StaticResource PrimaryButton}" HorizontalContentAlignment="Center" AutomationProperties.Name="선택한 작업 실행"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="OpenProgramButton" Content="{Binding SelectedProgram.OpenActionLabel}" Click="OpenProgram_Click" IsEnabled="{Binding CanOpenSelectedProgram}" Visibility="{Binding ShowSeparateOpenButton, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="선택한 파일 또는 폴더 보기"/><Button x:Name="StopProgramButton" Grid.Column="2" Content="중지" Click="StopProgram_Click" Visibility="{Binding HasSelectedCommands, Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding CanStopSelectedProgram}" AutomationProperties.Name="실행 중인 작업 중지"/></Grid></StackPanel>
        </Grid>
       </Border>
      </Grid>
      <Border x:Name="LogPanel" Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,0"><Expander x:Name="LogExpander" Header="작업 기록" IsExpanded="False"><ListBox x:Name="JobLogList" ItemsSource="{Binding JobLogs}" Height="100" FontSize="12" Padding="0" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0,3"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle></ListBox></Expander></Border>
     </Grid>
    </Grid>
   </TabItem>
   <TabItem Header="연결·관리"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,20,0,0">
    <TextBlock Text="프로젝트 폴더" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="이 폴더 안의 프로젝트를 찾아 내 프로젝트에 표시합니다." Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="프로젝트 상위 폴더" MinWidth="250"/><Button Grid.Column="1" Content="폴더 선택" Click="ChooseRoot_Click" Margin="10,0,0,0"/></Grid>
    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,26,0,0" Padding="0,22,0,0"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="작업에 필요한 연결" FontSize="20" FontWeight="SemiBold"/><Button Grid.Column="1" Content="연결 확인" Click="Refresh_Click"/></Grid><ItemsControl ItemsSource="{Binding UserFacingStatuses}" Margin="0,14,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="18" Padding="18" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="{Binding Purpose}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,5,20,0"/><Expander Header="자세한 확인 결과" IsExpanded="False" Margin="0,5,20,0"><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12"/></Expander></StackPanel><Border Grid.Column="1" Background="{DynamicResource RaisedBrush}" Padding="9,5" CornerRadius="4" VerticalAlignment="Top"><TextBlock Text="{Binding StateLabel}" FontSize="12"/></Border></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><WrapPanel Margin="0,8,0,0"><Button Content="공유 연결 시작" Click="EnsureRemote_Click" Margin="0,0,8,0"/><Button Content="자동 시작 정리" Click="ConsolidateRemote_Click" Margin="0,0,8,0"/><Button Content="AI 작업 전달" Click="Jev_Click"/></WrapPanel></StackPanel></Border>
    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,26,0,0" Padding="0,22,0,0"><StackPanel><TextBlock Text="앱 관리" FontSize="20" FontWeight="SemiBold"/><WrapPanel Margin="0,14,0,0"><Button Content="설치 · 자동 시작" Click="Install_Click" Margin="0,0,8,0"/><Button Content="공유 연결 복구" Click="Restore_Click" Margin="0,0,8,0"/><Button Content="앱 제거" Click="Uninstall_Click"/></WrapPanel><CheckBox Content="화면 전환 효과 줄이기" IsChecked="{Binding ReduceMotion, Mode=TwoWay}" Margin="0,18,0,0"/></StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="공지사항" x:Name="NoticeTab">
    <Grid x:Name="NoticeWorkspace" Margin="0,18,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="공지사항" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{Binding CentralSyncMessage}" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0"/></StackPanel><Button Grid.Column="1" Content="지금 동기화" Click="CommunicationSync_Click" VerticalAlignment="Center"/></Grid>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid><ListBox x:Name="NoticeList" ItemsSource="{Binding Notices}" SelectedItem="{Binding SelectedNotice,Mode=TwoWay}" AutomationProperties.Name="현재 공지"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding VersionLabel}" Style="{StaticResource Eyebrow}" Margin="0,10,0,0"/><TextBlock Text="{Binding ReadSummary}" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="연결되면 현재 공지를 표시합니다." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="14" Visibility="{Binding NoNotices,Converter={StaticResource BoolVisibility}}"/></Grid>
      <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="22" Padding="22"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel><TextBlock Text="{Binding SelectedNotice.Title,TargetNullValue=공지를 선택하세요}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedNotice.VersionLabel}" Style="{StaticResource Eyebrow}" Margin="0,8,0,0"/></StackPanel>
       <RichTextBox x:Name="NoticeBody" Grid.Row="1" services:NoticeDocument.Text="{Binding SelectedNotice.Notice.Body,Mode=OneWay}" IsReadOnly="True" IsDocumentEnabled="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,22,0,18" FontSize="14" AutomationProperties.Name="선택한 공지 내용"/>
       <Expander Grid.Row="2" x:Name="ReceiptExpander" Header="누가 확인했나요?" IsExpanded="True"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="실제로 남긴 기록입니다. 공지 배포만으로 읽음 처리하지 않습니다." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,9"/><ListBox Grid.Row="1" x:Name="ReceiptList" ItemsSource="{Binding SelectedNoticeReceipts}" MaxHeight="160"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Actor}" FontWeight="SemiBold"/><TextBlock Text="{Binding Project}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/><Expander Header="적용 내용" IsExpanded="False"><TextBlock Text="{Binding Note}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/></Expander></StackPanel><StackPanel Grid.Column="1" Margin="16,0,0,0"><TextBlock Text="{Binding State}" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right"/><TextBlock Text="{Binding CheckedAt}" Foreground="{DynamicResource MutedBrush}" FontSize="12" HorizontalAlignment="Right" Margin="0,5,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Expander>
      </Grid></Border>
     </Grid>
    </Grid>
   </TabItem>
   <TabItem Header="프로젝트 소통" x:Name="CommunicationTab">
    <Grid x:Name="CommunicationWorkspace" Margin="0,18,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="프로젝트 소통" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{Binding CommunicationMessage}" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0"/></StackPanel><Button Grid.Column="1" Content="지금 동기화" Click="CommunicationSync_Click" VerticalAlignment="Center"/></Grid>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="프로젝트별 전달·확인" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/><ListBox Grid.Row="1" x:Name="CommunicationProjectList" ItemsSource="{Binding CommunicationProjects}" SelectedItem="{Binding SelectedCommunicationProject,Mode=TwoWay}"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Delivery}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap"/><Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Read}" Foreground="{DynamicResource AccentBrush}" FontSize="12"/><TextBlock Grid.Column="1" Text="{Binding Applied}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/></Grid></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Grid.Row="2" Margin="0,12,0,0"><Button Content="선택 프로젝트 폴더 연결" Click="LinkCommunicationProject_Click"/><Button Content="소통 폴더 보기" Click="OpenCommunicationFolder_Click" Style="{StaticResource QuietButton}" Margin="0,7,0,0"/></StackPanel></Grid>
      <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="3*"/></Grid.RowDefinitions><TextBlock Text="수집한 전달 자료" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/><Grid Grid.Row="1"><ListBox x:Name="InboxList" ItemsSource="{Binding InboxItems}" SelectedItem="{Binding SelectedInbox,Mode=TwoWay}"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Project}" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,5,0,0"/><TextBlock Text="{Binding Preview}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Time}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="14,0,0,0"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="400" Visibility="{Binding NoInboxItems,Converter={StaticResource BoolVisibility}}"><TextBlock Text="아직 전달된 자료가 없습니다" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="프로젝트의 ‘보낼자료’ 폴더에 남기면 여기로 모입니다." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0" TextAlignment="Center"/></StackPanel></Grid><Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="22" Padding="18" Margin="0,16,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{Binding SelectedInbox.Title,TargetNullValue=전달 자료}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBox Grid.Row="1" Text="{Binding SelectedInbox.Body,Mode=OneWay}" IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,14,0,12"/><Button Grid.Row="2" Content="수집 파일 위치 보기" Click="OpenCollectedFile_Click" HorizontalAlignment="Right"/></Grid></Border></Grid>
     </Grid>
     <Expander Grid.Row="2" Header="자동화 설정·보류 내역" IsExpanded="False" Margin="0,14,0,0"><StackPanel><WrapPanel><CheckBox Content="공지 전달·기록 수집 자동 실행" IsChecked="{Binding AutoCommunication,Mode=TwoWay}" Margin="0,0,18,0"/><CheckBox Content="수집 기록 GitHub 자동 동기화" IsChecked="{Binding AutoPublishCommunication,Mode=TwoWay}"/></WrapPanel><TextBlock Text="앱이 켜져 있을 때 변경분을 수집합니다. 종료·연결 끊김 중에는 다음 실행에서 이어갑니다." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,9,0,0"/><TextBlock Text="{Binding CentralSyncMessage}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/><TextBlock Text="{Binding CommunicationCheckedAt}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/><ItemsControl ItemsSource="{Binding CommunicationErrors}" MaxHeight="80" Margin="0,6,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{DynamicResource DangerBrush}" FontSize="12" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Expander>
    </Grid>
   </TabItem>
   <TabItem x:Name="ServerTab" Header="멀티의 신 서버">
    <Grid Margin="0,22,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="ServerHeading" Text="멀티의 신 서버" FontSize="28" FontWeight="SemiBold"/>
      <Button Grid.Column="1" Content="상태 새로고침" Click="RefreshServer_Click" VerticalAlignment="Center"/>
     </Grid>
     <Border Grid.Row="1" Background="{DynamicResource CardFace}" BorderBrush="{DynamicResource RimBrush}" BorderThickness="1" CornerRadius="14" Padding="16,12" Margin="0,0,0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="RosterSpinner" Text="&#xE895;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource AccentBrush}" Margin="0,0,12,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><TextBlock.RenderTransform><RotateTransform/></TextBlock.RenderTransform><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Opacity" Value="0.45"/><Style.Triggers><DataTrigger Binding="{Binding IsUpdatingRoster}" Value="True"><Setter Property="Opacity" Value="1"/><DataTrigger.EnterActions><BeginStoryboard x:Name="RosterSpin"><Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.8" RepeatBehavior="Forever"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions><DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="RosterSpin"/></DataTrigger.ExitActions></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <TextBlock Grid.Column="1" Text="{Binding RosterStatus}" VerticalAlignment="Center" TextWrapping="Wrap"/><TextBlock Grid.Column="2" Text="{Binding RosterCheckedAt}" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
     </Grid></Border>
     <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="접속 중인 사람" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,14"/>
       <Grid Grid.Row="1"><ScrollViewer x:Name="ServerModePanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding ServerPlayers}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource CardFace}" BorderBrush="{DynamicResource RimBrush}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="2,2,6,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Nickname}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Nickname}"/><TextBlock Text="{Binding GuildLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"><Border Background="{DynamicResource SelectionFace}" CornerRadius="9" Padding="10,7"><TextBlock Text="{Binding StatusLabel}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="190"/></Border><TextBlock Text="{Binding ElapsedLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="12" HorizontalAlignment="Right" Margin="0,5,2,0"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><TextBlock Text="현재 접속 중인 사람이 없습니다." Foreground="{DynamicResource MutedBrush}" Margin="14,20" Visibility="{Binding RosterEmpty, Converter={StaticResource BoolVisibility}}"/></Grid>
      </Grid>
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel>
       <TextBlock Text="서버 연결" FontSize="17" FontWeight="SemiBold"/><WrapPanel Margin="0,14,0,0"><Button Content="실행 폴더 보기" Click="OpenServerFolder_Click" Margin="0,0,8,8"/><Button Content="소통 폴더 보기" Click="OpenServerMailbox_Click" Margin="0,0,8,8"/></WrapPanel>
       <TextBlock Text="{Binding ServerSummaryMessage}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,18"/>
       <TextBlock Text="GitHub 저장소" FontSize="17" FontWeight="SemiBold"/><WrapPanel Margin="0,14,0,6"><Button Content="개발 코드" Click="OpenServerSource_Click" Margin="0,0,8,8"/><Button Content="배포·설치파일" Click="OpenServerRelease_Click" Margin="0,0,8,8"/></WrapPanel><TextBlock Text="게임 수정은 개발 코드에서, 사용 버전은 배포 저장소에서 확인합니다." Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,18"/>
       <Expander Header="업데이트·접속 정책" IsExpanded="False"><StackPanel><TextBlock Text="서버가 안내하는 업데이트" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding ServerUpdatePolicy}" Margin="0,6,0,12"/><TextBlock Text="{Binding ServerMinimumBuild}"/><TextBlock Text="{Binding ServerBlockedBuilds}" Margin="0,6,0,0"/><TextBlock Text="{Binding ServerPolicyHealth}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,8,0,0"/><TextBlock Text="최신 설치파일 버전과 서버의 업데이트 정책은 다를 수 있습니다." Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Expander>
       <Expander Header="연결 위치·관리 동작" IsExpanded="False"><StackPanel><TextBlock Text="{Binding ServerRootPath}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/><Button Content="서버 폴더 변경" Click="LinkServerFolder_Click" HorizontalAlignment="Left"/><TextBlock Text="기존 관리창은 이전 서버 버전을 가리킵니다. 시작·종료·재시작은 실행 중인 버전과 연결을 맞춘 뒤 제공됩니다." Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Expander>
      </StackPanel></ScrollViewer>
     </Grid>
    </Grid>
   </TabItem>
  </TabControl>
  <TextBlock Grid.Row="2" Text="{Binding Message}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}" Margin="0,12,0,0" MaxHeight="20"/>
 </Grid>
</Window>
