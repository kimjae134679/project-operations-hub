<Window x:Class="AIControlTower.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:services="clr-namespace:AIControlTower.Services" Style="{StaticResource {x:Type Window}}" Title="내 프로젝트 · 컨트롤타워" Width="1460" Height="920" MinWidth="1060" MinHeight="720" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="ProjectFolder_Drop">
 <Window.Resources>
  <Style x:Key="ProjectRow" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}"/><Setter Property="Padding" Value="12,14"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Tile" Background="Transparent" CornerRadius="12" Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="1"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="#EEF0F7"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="Background" Value="#E8EDFF"/><Setter TargetName="Tile" Property="BorderBrush" Value="#A7B9FF"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="ProjectBadge" TargetType="Border"><Setter Property="Background" Value="#E4E7EE"/><Style.Triggers><DataTrigger Binding="{Binding Id}" Value="phonelol-current"><Setter Property="Background" Value="#DCD8F8"/></DataTrigger><DataTrigger Binding="{Binding Id}" Value="audiobook"><Setter Property="Background" Value="#F7D5C7"/></DataTrigger><DataTrigger Binding="{Binding Id}" Value="video-downloader"><Setter Property="Background" Value="#CDE6F3"/></DataTrigger><DataTrigger Binding="{Binding Id}" Value="project-operations-hub"><Setter Property="Background" Value="#D9E7D5"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="ProgramRow" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0"/><Setter Property="MinHeight" Value="158"/><Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}"/><Setter Property="Cursor" Value="Hand"/></Style>
 </Window.Resources>
 <Grid x:Name="ContentShell" Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="PageHeader" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="30" Height="30" CornerRadius="7" Background="{StaticResource ActionFace}" BorderBrush="#9FB7FF" BorderThickness="1" Margin="0,0,10,0"><Path Data="M 0 0 L 12 0 L 12 5 L 0 5 Z M 0 8 L 5 8 L 5 19 L 0 19 Z M 8 8 L 12 8 L 12 19 L 8 19 Z" Fill="{StaticResource AccentInkBrush}" Width="12" Height="19" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="PageTitle" Text="컨트롤타워" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="프로젝트 폴더 선택" Click="ChooseRoot_Click" ToolTip="프로젝트가 들어 있는 상위 폴더를 선택합니다. 폴더를 이 창으로 끌어와도 됩니다." Margin="0,0,8,0"/><Button Content="새로고침" Click="Discover_Click" Margin="0,0,8,0"/><Button Content="지금 동기화" Click="CommunicationSync_Click" ToolTip="{Binding CentralSyncMessage}"/></StackPanel>
  </Grid>
  <TabControl x:Name="WorkspaceTabs" Grid.Row="1" SelectionChanged="WorkspaceTabs_SelectionChanged">
   <TabItem Header="내 프로젝트">
    <Grid x:Name="WorkspaceContent" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition x:Name="CatalogColumn" Width="238"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Background="{StaticResource CardFace}" BorderBrush="{StaticResource RimBrush}" BorderThickness="1" CornerRadius="16" Padding="10,14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,14"><TextBox x:Name="ProjectSearchBox" Style="{StaticResource SearchBox}" Tag="프로젝트 찾기" Text="{Binding ProjectSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="프로젝트 찾기"/><TextBlock Text="프로젝트 찾기" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ProjectSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
      <Grid Grid.Row="1"><ListBox ScrollViewer.CanContentScroll="False" x:Name="ProjectList" ItemsSource="{Binding FilteredProjects}" SelectedItem="{Binding SelectedProject, Mode=TwoWay}" SelectionChanged="Projects_SelectionChanged" ItemContainerStyle="{StaticResource ProjectRow}" Padding="0,0,6,0" AutomationProperties.Name="내 프로젝트"><ListBox.ItemTemplate><DataTemplate>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource ProjectBadge}" Width="32" Height="36" CornerRadius="9" VerticalAlignment="Top"><TextBlock Text="{Binding Monogram}" Foreground="#273450" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/><TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxHeight="36" LineHeight="17" TextTrimming="CharacterEllipsis" Margin="0,7,0,0"/><TextBlock Text="{Binding RoleLabel}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/></StackPanel></Grid>
      </DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="검색 결과가 없습니다." Foreground="{StaticResource MutedBrush}" Margin="14,18" Visibility="{Binding NoProjectSearchResults, Converter={StaticResource BoolVisibility}}"/></Grid>
     </Grid></Border>
     <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border x:Name="ProjectHeader" BorderThickness="0" CornerRadius="18" Padding="24" Margin="0,0,0,16">
       <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#E6E8F3"/><Style.Triggers><DataTrigger Binding="{Binding SelectedProject.Id}" Value="audiobook"><Setter Property="Background" Value="#F8E3D9"/></DataTrigger><DataTrigger Binding="{Binding SelectedProject.Id}" Value="video-downloader"><Setter Property="Background" Value="#DAEAF2"/></DataTrigger><DataTrigger Binding="{Binding SelectedProject.Id}" Value="project-operations-hub"><Setter Property="Background" Value="#E2EBDD"/></DataTrigger><DataTrigger Binding="{Binding SelectedProject.Id}" Value="phonelol-current"><Setter Property="Background" Value="#E4E0F6"/></DataTrigger></Style.Triggers></Style></Border.Style>
       <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="{Binding SelectedProject.CategoryLabel}" Style="{StaticResource Eyebrow}" Margin="0,0,0,5"/><TextBlock x:Name="ProjectTitle" Text="{Binding SelectedProject.DisplayName, TargetNullValue=프로젝트를 선택하세요}" FontSize="32" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedProject.DisplayName}" Margin="0,0,14,0"/></StackPanel>
        <Button Grid.Column="1" Content="폴더 보기" Click="OpenProject_Click" VerticalAlignment="Center" AutomationProperties.Name="프로젝트 폴더 보기"/>
        <TextBlock x:Name="ProjectDescription" Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding SelectedProject.Description}" Foreground="{StaticResource MutedBrush}" FontSize="14" TextWrapping="Wrap" MaxHeight="44" TextTrimming="CharacterEllipsis" Margin="0,10,0,0"/>
        <Expander x:Name="ProjectPathLine" Grid.Row="2" Grid.ColumnSpan="2" IsExpanded="False" Header="폴더 위치" Margin="0,4,0,0"><TextBlock Text="{Binding SelectedProject.Path}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></Expander>
       </Grid>
      </Border>
      <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition x:Name="InspectorColumn" Width="258"/></Grid.ColumnDefinitions>
       <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,8"><TextBox x:Name="ProgramSearchBox" Style="{StaticResource SearchBox}" Tag="프로그램 · 자료 찾기" Text="{Binding ProgramSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="프로그램 찾기"/><TextBlock Text="프로그램·자료 찾기" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ProgramSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
        <Grid Grid.Row="1"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding FilteredFunctions}"><ItemsControl.ItemTemplate><DataTemplate><Expander Margin="0,0,0,6"><Expander.Style><Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}"><Setter Property="IsExpanded" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding IsAdvanced}" Value="True"><Setter Property="IsExpanded" Value="False"/></DataTrigger></Style.Triggers></Style></Expander.Style><Expander.Header><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/></Expander.Header><ListBox ItemsSource="{Binding Programs}" SelectedItem="{Binding DataContext.SelectedProgram, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" SelectionChanged="Programs_SelectionChanged" ItemContainerStyle="{StaticResource ProgramRow}" ScrollViewer.VerticalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><services:ResponsiveCardPanel MinimumCardWidth="260" Gap="12"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="#F0F2F8" CornerRadius="8" Padding="7,5" HorizontalAlignment="Left"><TextBlock Text="{Binding KindLabel}" FontSize="11" Foreground="#46536D"/></Border><TextBlock Grid.Column="1" Text="{Binding StatusLabel}" Foreground="{StaticResource AccentBrush}" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/></Grid><TextBlock Grid.Row="1" Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" ToolTip="{Binding DisplayName}" Margin="0,14,0,0"/><TextBlock Grid.Row="2" Text="{Binding Description}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxHeight="40" LineHeight="18" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Expander></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><TextBlock Text="검색 결과가 없습니다." Foreground="{StaticResource MutedBrush}" Margin="12,18" Visibility="{Binding NoProgramSearchResults, Converter={StaticResource BoolVisibility}}"/></Grid>
       </Grid>
       <Border x:Name="ProgramInspector" Grid.Column="2" Background="{StaticResource CardFace}" BorderBrush="{StaticResource RimBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="InspectorMetadataRow" Height="*" MinHeight="0"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <StackPanel><TextBlock Text="{Binding SelectedProgram.KindLabel, TargetNullValue=프로그램 · 자료}" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="InspectorTitle" Text="{Binding SelectedProgram.DisplayName, TargetNullValue=목록에서 선택하세요}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip="{Binding SelectedProgram.DisplayName}" Margin="0,7,0,0"/><TextBlock Text="{Binding SelectedProgram.StatusLabel}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,0"/></StackPanel>
         <ScrollViewer x:Name="InspectorMetadata" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,16,0,14"><StackPanel><TextBlock Text="선택한 항목" Style="{StaticResource Eyebrow}" Margin="0,0,0,7"/><TextBlock Text="{Binding SelectedProgram.Description}" TextWrapping="Wrap" FontSize="14" LineHeight="22"/><Expander Header="파일 위치" IsExpanded="False" Margin="0,12,0,0"><TextBlock Text="{Binding SelectedProgram.Path}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/></Expander></StackPanel></ScrollViewer>
         <StackPanel Grid.Row="2" Margin="0,16,0,0"><TextBlock Text="작업 선택" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/><ComboBox x:Name="CommandSelector" ItemsSource="{Binding SelectedProgram.Commands}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedCommand, Mode=TwoWay}" IsEnabled="{Binding CanLaunchSelectedProgram}" Visibility="{Binding HasSelectedCommands, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="실행할 작업" Margin="0,0,0,8"/><Button x:Name="LaunchProgramButton" Content="{Binding SelectedProgram.ActionLabel, TargetNullValue=작업 실행}" Click="LaunchProgram_Click" IsEnabled="{Binding CanLaunchSelectedProgram}" Style="{StaticResource PrimaryButton}" HorizontalContentAlignment="Center" AutomationProperties.Name="선택한 작업 실행"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="OpenProgramButton" Content="{Binding SelectedProgram.OpenActionLabel}" Click="OpenProgram_Click" IsEnabled="{Binding CanOpenSelectedProgram}" Visibility="{Binding ShowSeparateOpenButton, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="선택한 파일 또는 폴더 보기"/><Button x:Name="StopProgramButton" Grid.Column="2" Content="중지" Click="StopProgram_Click" Visibility="{Binding HasSelectedCommands, Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding CanStopSelectedProgram}" AutomationProperties.Name="실행 중인 작업 중지"/></Grid></StackPanel>
        </Grid>
       </Border>
      </Grid>
      <Border x:Name="LogPanel" Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,0"><Expander x:Name="LogExpander" Header="작업 기록" IsExpanded="False"><ListBox x:Name="JobLogList" ItemsSource="{Binding JobLogs}" Height="100" FontSize="12" Padding="0" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0,3"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle></ListBox></Expander></Border>
     </Grid>
    </Grid>
   </TabItem>
   <TabItem Header="연결·관리"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,20,0,0">
    <TextBlock Text="프로젝트 폴더" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="이 폴더 안의 프로젝트를 찾아 내 프로젝트에 표시합니다." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="프로젝트 상위 폴더" MinWidth="500"/><Button Grid.Column="1" Content="폴더 선택" Click="ChooseRoot_Click" Margin="10,0,0,0"/></Grid>
    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,26,0,0" Padding="0,22,0,0"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="작업에 필요한 연결" FontSize="20" FontWeight="SemiBold"/><Button Grid.Column="1" Content="연결 확인" Click="Refresh_Click"/></Grid><ItemsControl ItemsSource="{Binding UserFacingStatuses}" Margin="0,14,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="{Binding Purpose}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,5,20,0"/><Expander Header="자세한 확인 결과" IsExpanded="False" Margin="0,5,20,0"><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12"/></Expander></StackPanel><Border Grid.Column="1" Background="{StaticResource RaisedBrush}" Padding="9,5" CornerRadius="4" VerticalAlignment="Top"><TextBlock Text="{Binding StateLabel}" FontSize="12"/></Border></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><WrapPanel Margin="0,8,0,0"><Button Content="공유 연결 시작" Click="EnsureRemote_Click" Margin="0,0,8,0"/><Button Content="자동 시작 정리" Click="ConsolidateRemote_Click" Margin="0,0,8,0"/><Button Content="AI 작업 전달" Click="Jev_Click"/></WrapPanel></StackPanel></Border>
    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,26,0,0" Padding="0,22,0,0"><StackPanel><TextBlock Text="앱 관리" FontSize="20" FontWeight="SemiBold"/><WrapPanel Margin="0,14,0,0"><Button Content="설치 · 자동 시작" Click="Install_Click" Margin="0,0,8,0"/><Button Content="공유 연결 복구" Click="Restore_Click" Margin="0,0,8,0"/><Button Content="앱 제거" Click="Uninstall_Click"/></WrapPanel><CheckBox Content="화면 전환 효과 줄이기" IsChecked="{Binding ReduceMotion, Mode=TwoWay}" Margin="0,18,0,0"/></StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="공지사항" x:Name="NoticeTab">
    <Grid x:Name="NoticeWorkspace" Margin="0,18,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="공지사항" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{Binding CentralSyncMessage}" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/></StackPanel><Button Grid.Column="1" Content="지금 동기화" Click="CommunicationSync_Click" VerticalAlignment="Center"/></Grid>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid><ListBox x:Name="NoticeList" ItemsSource="{Binding Notices}" SelectedItem="{Binding SelectedNotice,Mode=TwoWay}" AutomationProperties.Name="현재 공지"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding VersionLabel}" Style="{StaticResource Eyebrow}" Margin="0,10,0,0"/><TextBlock Text="{Binding ReadSummary}" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="연결되면 현재 공지를 표시합니다." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="14" Visibility="{Binding NoNotices,Converter={StaticResource BoolVisibility}}"/></Grid>
      <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="22"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel><TextBlock Text="{Binding SelectedNotice.Title,TargetNullValue=공지를 선택하세요}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedNotice.VersionLabel}" Style="{StaticResource Eyebrow}" Margin="0,8,0,0"/></StackPanel>
       <RichTextBox x:Name="NoticeBody" Grid.Row="1" services:NoticeDocument.Text="{Binding SelectedNotice.Notice.Body,Mode=OneWay}" IsReadOnly="True" IsDocumentEnabled="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,22,0,18" FontSize="14" AutomationProperties.Name="선택한 공지 내용"/>
       <Expander Grid.Row="2" x:Name="ReceiptExpander" Header="누가 확인했나요?" IsExpanded="True"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="실제로 남긴 기록입니다. 공지 배포만으로 읽음 처리하지 않습니다." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,9"/><ListBox Grid.Row="1" x:Name="ReceiptList" ItemsSource="{Binding SelectedNoticeReceipts}" MaxHeight="160"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Actor}" FontWeight="SemiBold"/><TextBlock Text="{Binding Project}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/><Expander Header="적용 내용" IsExpanded="False"><TextBlock Text="{Binding Note}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></Expander></StackPanel><StackPanel Grid.Column="1" Margin="16,0,0,0"><TextBlock Text="{Binding State}" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right"/><TextBlock Text="{Binding CheckedAt}" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Right" Margin="0,5,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Expander>
      </Grid></Border>
     </Grid>
    </Grid>
   </TabItem>
   <TabItem Header="프로젝트 소통" x:Name="CommunicationTab">
    <Grid x:Name="CommunicationWorkspace" Margin="0,18,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="프로젝트 소통" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{Binding CommunicationMessage}" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/></StackPanel><Button Grid.Column="1" Content="지금 동기화" Click="CommunicationSync_Click" VerticalAlignment="Center"/></Grid>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="프로젝트별 전달·확인" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/><ListBox Grid.Row="1" x:Name="CommunicationProjectList" ItemsSource="{Binding CommunicationProjects}" SelectedItem="{Binding SelectedCommunicationProject,Mode=TwoWay}"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Delivery}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap"/><Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Read}" Foreground="{StaticResource AccentBrush}" FontSize="12"/><TextBlock Grid.Column="1" Text="{Binding Applied}" Foreground="{StaticResource MutedBrush}" FontSize="12"/></Grid></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Grid.Row="2" Margin="0,12,0,0"><Button Content="선택 프로젝트 폴더 연결" Click="LinkCommunicationProject_Click"/><Button Content="소통 폴더 보기" Click="OpenCommunicationFolder_Click" Style="{StaticResource QuietButton}" Margin="0,7,0,0"/></StackPanel></Grid>
      <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="3*"/></Grid.RowDefinitions><TextBlock Text="수집한 전달 자료" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/><Grid Grid.Row="1"><ListBox x:Name="InboxList" ItemsSource="{Binding InboxItems}" SelectedItem="{Binding SelectedInbox,Mode=TwoWay}"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Project}" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,5,0,0"/><TextBlock Text="{Binding Preview}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Time}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="14,0,0,0"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="400" Visibility="{Binding NoInboxItems,Converter={StaticResource BoolVisibility}}"><TextBlock Text="아직 전달된 자료가 없습니다" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="프로젝트의 ‘보낼자료’ 폴더에 남기면 여기로 모입니다." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0" TextAlignment="Center"/></StackPanel></Grid><Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,16,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{Binding SelectedInbox.Title,TargetNullValue=전달 자료}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBox Grid.Row="1" Text="{Binding SelectedInbox.Body,Mode=OneWay}" IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,14,0,12"/><Button Grid.Row="2" Content="수집 파일 위치 보기" Click="OpenCollectedFile_Click" HorizontalAlignment="Right"/></Grid></Border></Grid>
     </Grid>
     <Expander Grid.Row="2" Header="자동화 설정·보류 내역" IsExpanded="False" Margin="0,14,0,0"><StackPanel><WrapPanel><CheckBox Content="공지 전달·기록 수집 자동 실행" IsChecked="{Binding AutoCommunication,Mode=TwoWay}" Margin="0,0,18,0"/><CheckBox Content="수집 기록 GitHub 자동 동기화" IsChecked="{Binding AutoPublishCommunication,Mode=TwoWay}"/></WrapPanel><TextBlock Text="앱이 켜져 있을 때 변경분을 수집합니다. 종료·연결 끊김 중에는 다음 실행에서 이어갑니다." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,9,0,0"/><TextBlock Text="{Binding CentralSyncMessage}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/><TextBlock Text="{Binding CommunicationCheckedAt}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/><ItemsControl ItemsSource="{Binding CommunicationErrors}" MaxHeight="80" Margin="0,6,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Expander>
    </Grid>
   </TabItem>
   <TabItem x:Name="ServerTab" Header="멀티의 신 서버">
    <Grid Margin="0,22,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock x:Name="ServerHeading" Text="멀티의 신 서버" FontSize="28" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Ellipse Width="7" Height="7" Margin="0,0,8,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{StaticResource MutedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding ServerSnapshot.IsHealthy}" Value="True"><Setter Property="Fill" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Text="{Binding ServerHealth}" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding ServerCheckedAt}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="18,2,0,0"/></StackPanel></StackPanel>
      <Button Grid.Column="1" Content="상태 새로고침" Click="RefreshServer_Click" VerticalAlignment="Center"/>
     </Grid>
     <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="24,20" Margin="0,0,0,22"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="접속 중" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding ServerOnline}" FontSize="42" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0"/></StackPanel>
      <StackPanel Grid.Column="1"><TextBlock Text="준비 중" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding ServerPreparing}" FontSize="42" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="플레이 중" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding ServerPlaying}" FontSize="42" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel>
      <StackPanel Grid.Column="3" VerticalAlignment="Bottom" MaxWidth="240"><TextBlock Text="{Binding ServerObservedAt}" Foreground="{StaticResource MutedBrush}" FontSize="12"/><TextBlock Text="준비·플레이 인원은 접속 인원에 포함됩니다." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
     </Grid></Border>
     <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="모드별 현재 인원" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14"/>
       <Grid Grid.Row="1" Margin="14,0,14,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><TextBlock Text="모드" Style="{StaticResource Eyebrow}"/><TextBlock Grid.Column="1" Text="접속" Style="{StaticResource Eyebrow}" TextAlignment="Right"/><TextBlock Grid.Column="2" Text="준비" Style="{StaticResource Eyebrow}" TextAlignment="Right"/><TextBlock Grid.Column="3" Text="플레이" Style="{StaticResource Eyebrow}" TextAlignment="Right"/></Grid>
       <ScrollViewer Grid.Row="2" x:Name="ServerModePanel" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding ServerModes}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Online}" TextAlignment="Right" Foreground="{StaticResource AccentBrush}"/><TextBlock Grid.Column="2" Text="{Binding Preparing}" TextAlignment="Right"/><TextBlock Grid.Column="3" Text="{Binding Playing}" TextAlignment="Right"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
      </Grid>
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel>
       <TextBlock Text="서버 연결" FontSize="17" FontWeight="SemiBold"/><WrapPanel Margin="0,14,0,0"><Button Content="실행 폴더 보기" Click="OpenServerFolder_Click" Margin="0,0,8,8"/><Button Content="소통 폴더 보기" Click="OpenServerMailbox_Click" Margin="0,0,8,8"/></WrapPanel>
       <TextBlock Text="{Binding ServerSummaryMessage}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,18"/>
       <TextBlock Text="GitHub 저장소" FontSize="17" FontWeight="SemiBold"/><WrapPanel Margin="0,14,0,6"><Button Content="개발 코드" Click="OpenServerSource_Click" Margin="0,0,8,8"/><Button Content="배포·설치파일" Click="OpenServerRelease_Click" Margin="0,0,8,8"/></WrapPanel><TextBlock Text="게임 수정은 개발 코드에서, 사용 버전은 배포 저장소에서 확인합니다." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,18"/>
       <Expander Header="업데이트·접속 정책" IsExpanded="False"><StackPanel><TextBlock Text="서버가 안내하는 업데이트" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding ServerUpdatePolicy}" Margin="0,6,0,12"/><TextBlock Text="{Binding ServerMinimumBuild}"/><TextBlock Text="{Binding ServerBlockedBuilds}" Margin="0,6,0,0"/><TextBlock Text="{Binding ServerPolicyHealth}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,0"/><TextBlock Text="최신 설치파일 버전과 서버의 업데이트 정책은 다를 수 있습니다." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Expander>
       <Expander Header="연결 위치·관리 동작" IsExpanded="False"><StackPanel><TextBlock Text="{Binding ServerRootPath}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/><Button Content="서버 폴더 변경" Click="LinkServerFolder_Click" HorizontalAlignment="Left"/><TextBlock Text="기존 관리창은 이전 서버 버전을 가리킵니다. 시작·종료·재시작은 실행 중인 버전과 연결을 맞춘 뒤 제공됩니다." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Expander>
      </StackPanel></ScrollViewer>
     </Grid>
    </Grid>
   </TabItem>
  </TabControl>
  <TextBlock Grid.Row="2" Text="{Binding Message}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}" Margin="0,12,0,0" MaxHeight="20"/>
 </Grid>
</Window>
