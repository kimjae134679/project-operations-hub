<Window x:Class="AIControlTower.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:services="clr-namespace:AIControlTower.Services" xmlns:views="clr-namespace:AIControlTower.Views" Style="{StaticResource {x:Type Window}}" Title="내 프로젝트 · 컨트롤타워" Width="1460" Height="920" MinWidth="1060" MinHeight="720" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="ProjectFolder_Drop">
 <Window.Resources>

  <!-- Navigation items keep automatic width so scrollbars and narrow viewports cannot clip their borders. -->
  <Style x:Key="WorkspaceTabItem" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
   <Setter Property="Margin" Value="0"/><Setter Property="MinHeight" Value="44"/>
   <Setter Property="HeaderTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="14" Margin="3,0" HorizontalAlignment="Left"/></DataTemplate></Setter.Value></Setter>
  </Style>

  <Style x:Key="ProjectRow" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
   <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}"/><Setter Property="Padding" Value="13,13"/><Setter Property="Margin" Value="1,2,1,9"/><Setter Property="Foreground" Value="{DynamicResource RailTextBrush}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Grid><Border x:Name="BackSheet" Background="{DynamicResource RailEdgeBrush}" CornerRadius="13" Margin="6,7,6,0" Visibility="Collapsed"/>
     <Border x:Name="Tile" Background="Transparent" CornerRadius="13" Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="1"><ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/></Border>
     <Border x:Name="Focus" BorderBrush="{DynamicResource BadgeBrush}" BorderThickness="2" CornerRadius="15" Margin="1" IsHitTestVisible="False" Visibility="Collapsed"/>
    </Grid><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource RailHoverBrush}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource RailSelectedBrush}"/><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource RailEdgeBrush}"/><Setter TargetName="BackSheet" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Focus" Property="Visibility" Value="Visible"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ProjectBadge" TargetType="Border"><Setter Property="Background" Value="{DynamicResource BadgeBrush}"/></Style>
  <Style x:Key="ProgramRow" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
   <Setter Property="Padding" Value="18,20,18,18"/><Setter Property="Margin" Value="1,5,2,8"/><Setter Property="MinHeight" Value="152"/><Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Grid x:Name="WorkCard">
    <Border x:Name="BackCard" Background="{DynamicResource SheetBackBrush}" CornerRadius="18" Margin="8,7,2,0"/>
    <Border x:Name="MiddleCard" Background="{DynamicResource SheetMiddleBrush}" CornerRadius="18" Margin="4,3,4,0"/>
    <Border x:Name="FrontCard" Background="{DynamicResource CardFace}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="18" Margin="0,0,8,4">
     <Grid><Border Background="{DynamicResource HighlightBrush}" Height="2" CornerRadius="1" Margin="17,1,17,0" VerticalAlignment="Top"/><ContentPresenter Margin="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}"/></Grid>
    </Border>
    <Border x:Name="SelectedLabel" Background="{DynamicResource ActionFace}" CornerRadius="0,0,9,9" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,23,0" Padding="9,3" Visibility="Collapsed"><TextBlock Text="선택" Foreground="{DynamicResource AccentInkBrush}" FontSize="10" FontWeight="SemiBold"/></Border>
    <Border x:Name="CardFocus" BorderBrush="{DynamicResource FocusBrush}" BorderThickness="2" CornerRadius="20" Margin="0,0,6,2" Visibility="Collapsed" IsHitTestVisible="False"/>
   </Grid><ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FrontCard" Property="Background" Value="{DynamicResource HoverBrush}"/><Setter TargetName="FrontCard" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter TargetName="FrontCard" Property="Background" Value="{DynamicResource SelectionFace}"/><Setter TargetName="FrontCard" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="SelectedLabel" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="CardFocus" Property="Visibility" Value="Visible"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid x:Name="ContentShell" Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="PageHeader" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="30" Height="30" CornerRadius="7" Background="{DynamicResource ActionFace}" BorderBrush="{DynamicResource RimBrush}" BorderThickness="1" Margin="0,0,10,0"><Path Data="M 0 0 L 12 0 L 12 5 L 0 5 Z M 0 8 L 5 8 L 5 19 L 0 19 Z M 8 8 L 12 8 L 12 19 L 8 19 Z" Fill="{DynamicResource AccentInkBrush}" Width="12" Height="19" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="PageTitle" Text="컨트롤타워" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
   <WrapPanel x:Name="ThemeControls" Grid.Column="1" MaxWidth="620" VerticalAlignment="Center"><Button x:Name="LightThemeButton" Content="밝게" Tag="light" Click="LightTheme_Click" Style="{StaticResource ThemeChoiceButton}" Margin="0,0,6,0" AutomationProperties.Name="밝은 화면 적용"/><Button x:Name="DarkThemeButton" Content="어둡게" Tag="dark" Click="DarkTheme_Click" Style="{StaticResource ThemeChoiceButton}" Margin="0,0,12,0" AutomationProperties.Name="어두운 화면 적용"/></WrapPanel>
  </Grid>
   <TabControl x:Name="WorkspaceTabs" TabStripPlacement="Left" Grid.Row="1" ItemContainerStyle="{StaticResource WorkspaceTabItem}" SelectionChanged="WorkspaceTabs_SelectionChanged">
   <TabItem Header="내 프로젝트" x:Name="ProjectsTab" IsSelected="True">
    <Grid x:Name="WorkspaceContent" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition x:Name="CatalogColumn" Width="238" MinWidth="190" MaxWidth="450"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*" MinWidth="540"/></Grid.ColumnDefinitions>
     <Border x:Name="ProjectRail" Background="{DynamicResource RailMaterial}" CornerRadius="14" Padding="14,20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Margin="5,0,5,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="내 프로젝트" ToolTip="이름으로 찾고 작업을 이어가세요" Foreground="{DynamicResource RailTextBrush}" FontSize="20" FontWeight="SemiBold"/></StackPanel><Border Grid.Column="1" Background="{DynamicResource RailSelectedBrush}" CornerRadius="11" Padding="10,6" VerticalAlignment="Center"><TextBlock Text="{Binding ProjectsCount}" Foreground="{DynamicResource RailTextBrush}" FontWeight="SemiBold"/></Border></Grid>
      <Grid Grid.Row="1"><ListBox ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" x:Name="ProjectList" ItemsSource="{Binding FilteredProjects}" SelectedItem="{Binding SelectedProject, Mode=TwoWay}" SelectionChanged="Projects_SelectionChanged" ItemContainerStyle="{StaticResource ProjectRow}" Padding="0,0,6,0" AutomationProperties.Name="내 프로젝트"><ListBox.ItemTemplate><DataTemplate>
       <StackPanel><DockPanel><services:IdentityIcon Identity="{Binding DisplayName}" Width="32" Height="32" Padding="7" Margin="0,0,10,0"/><TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource RailTextBrush}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="23" ToolTip="{Binding DisplayName}" VerticalAlignment="Center"/></DockPanel></StackPanel>
      </DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="프로젝트 없음" Foreground="{DynamicResource RailMutedBrush}" Margin="14,18" Visibility="{Binding NoProjectSearchResults, Converter={StaticResource BoolVisibility}}"/></Grid>
     </Grid></Border>
     <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" AutomationProperties.Name="프로젝트 목록 너비 조절"/>
     <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="140"/></Grid.RowDefinitions>

      <Border x:Name="ProjectHeader" Margin="0,0,0,18">
       <Grid>
        <Border Background="{DynamicResource SheetBackBrush}" CornerRadius="16" Margin="8,10,0,0" IsHitTestVisible="False"/>
        <Border Background="{DynamicResource SheetMiddleBrush}" CornerRadius="16" Margin="4,3,4,4" IsHitTestVisible="False"/>
        <Border x:Name="ProjectHeaderFace" Background="{DynamicResource HeroFace}" BorderBrush="{DynamicResource RimBrush}" BorderThickness="1" CornerRadius="16" Margin="0,0,8,8" Padding="24">
         <Grid x:Name="ProjectHeaderBody"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock x:Name="ProjectCategory" Text="{Binding SelectedProject.CategoryLabel}" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/><TextBlock x:Name="ProjectTitle" Text="{Binding SelectedProject.DisplayName,TargetNullValue=프로젝트를 선택하세요}" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip="{Binding SelectedProject.DisplayName}"/></StackPanel>
          <WrapPanel Grid.Row="1" Margin="0,12,0,0"><TextBlock x:Name="CreateFlowHint" Text="프로젝트 선택 → 항목 선택 → 만들기·결과 열기" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,14,6"/><Button Content="사용 안내 읽기" Click="OpenProjectGuide_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,6" AutomationProperties.Name="선택 프로젝트 사용 안내 읽기"/><Button Content="폴더 보기" Click="OpenProject_Click" Margin="0,0,0,6" AutomationProperties.Name="프로젝트 폴더 보기"/></WrapPanel>
          <TextBlock x:Name="ProjectDescription" Grid.Row="2" Text="{Binding SelectedProject.Description}" Foreground="{DynamicResource MutedBrush}" FontSize="14" TextWrapping="Wrap" MaxHeight="44" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
          <Expander x:Name="ProjectPathLine" Grid.Row="3" IsExpanded="False" Header="폴더 위치" Margin="0,8,0,0"><TextBlock Text="{Binding SelectedProject.Path}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/></Expander>
         </Grid>
        </Border>
       </Grid>
      </Border>
          <Border x:Name="ProjectProgressCard" Grid.Row="1" DataContext="{Binding SelectedProjectProgress}" Background="{DynamicResource CardFace}" BorderBrush="{DynamicResource RimBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
           <StackPanel>
            <WrapPanel><TextBlock Text="{Binding Headline}" FontSize="16" FontWeight="SemiBold" Margin="0,0,12,2"/><TextBlock Text="{Binding CountsText}" VerticalAlignment="Center" FontSize="12"/></WrapPanel>
            <ProgressBar Value="{Binding ProgressValue,Mode=OneWay}" Minimum="0" Maximum="100" Height="4" Margin="0,4,0,6" Visibility="{Binding IsKnown,Converter={StaticResource BoolVisibility}}"/>
            <WrapPanel><TextBlock Text="{Binding ScopeText}" FontSize="12" Margin="0,0,12,2"/><TextBlock Text="{Binding ChapterText}" FontSize="12" Margin="0,0,12,2"/><TextBlock Text="{Binding StageText}" FontSize="12"/></WrapPanel>
            <TextBlock Text="{Binding FreshnessText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding SourceTimeText}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
            <Expander Header="진행 근거·실제 인수인계" IsExpanded="False" Margin="0,6,0,0"><ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto"><StackPanel>
             <TextBlock Text="{Binding OverallText}" FontSize="12" TextWrapping="Wrap"/>
             <TextBlock Text="{Binding ObservationTimeText}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
             <TextBlock Text="{Binding WorkerText}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,8"/>
             <StackPanel DataContext="{Binding DataContext,RelativeSource={RelativeSource AncestorType=Window}}">
              <TextBlock Text="{Binding ProjectHandoffSummary}" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding ProjectCommunicationFlowText}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,6"/>
              <TextBlock Text="명령 / 이미 전달한 답변" FontSize="11" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding SelectedProjectHandoff.CommandSummary}" FontSize="12" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding SelectedProjectHandoff.ResponseSummary}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,6"/>
              <TextBlock Text="실제 한 일 / 검증·다음 할 일" FontSize="11" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding SelectedProjectHandoff.RecentLog}" FontSize="12" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding SelectedProjectHandoff.NextCheckpoint}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,8"/>
              <TextBlock Text="등록 프로젝트 진행 요약 · 전체 완료율 아님" FontSize="11" FontWeight="SemiBold"/>
              <ItemsControl ItemsSource="{Binding ProjectProgressSummaries}"><ItemsControl.ItemTemplate><DataTemplate><WrapPanel><TextBlock Text="{Binding ProjectName}" FontSize="12" Margin="0,0,12,2"/><TextBlock Text="{Binding Headline}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/></WrapPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
             </StackPanel>
            </StackPanel></ScrollViewer></Expander>
           </StackPanel>
          </Border>
      <TabControl x:Name="ProjectContentTabs" Grid.Row="2" SelectionChanged="ProjectContentTabs_SelectionChanged">
       <TabItem Header="만들기·제작물" IsSelected="True"><Grid><Grid.RowDefinitions><RowDefinition Height="*" MinHeight="140"/><RowDefinition Height="28"/><RowDefinition x:Name="JobLogRow" Height="Auto" MinHeight="0" MaxHeight="320"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="240"/><ColumnDefinition Width="28"/><ColumnDefinition x:Name="InspectorColumn" Width="258" MinWidth="220" MaxWidth="500"/></Grid.ColumnDefinitions>
       <Grid>
        <Grid><ScrollViewer x:Name="ProgramScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding FilteredFunctions}"><ItemsControl.ItemTemplate><DataTemplate><Expander Margin="0,0,0,6"><Expander.Style><Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}"><Setter Property="IsExpanded" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding IsAdvanced}" Value="True"><Setter Property="IsExpanded" Value="False"/></DataTrigger></Style.Triggers></Style></Expander.Style><Expander.Header><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/></Expander.Header><ListBox ItemsSource="{Binding Programs}" SelectedItem="{Binding DataContext.SelectedProgram, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" SelectionChanged="Programs_SelectionChanged" ItemContainerStyle="{StaticResource ProgramRow}" ScrollViewer.VerticalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><services:ResponsiveCardPanel MinimumCardWidth="260" Gap="12"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="{DynamicResource ChipBrush}" CornerRadius="8" Padding="7,5" HorizontalAlignment="Left"><TextBlock Text="{Binding KindLabel}" FontSize="11" Foreground="{DynamicResource ChipInkBrush}"/></Border><services:StatusBadge Grid.Column="1" Value="{Binding StatusLabel}" VerticalAlignment="Center" Margin="6,0,0,0"/></Grid><DockPanel Grid.Row="1" Margin="0,12,0,0"><services:IdentityIcon Identity="{Binding DisplayName}" Width="34" Height="34" Padding="8" Margin="0,0,10,0"/><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" ToolTip="{Binding DisplayName}" VerticalAlignment="Center"/></DockPanel><TextBlock Grid.Row="2" Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" MaxHeight="40" LineHeight="18" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Expander></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><TextBlock Text="자료 없음" Foreground="{DynamicResource MutedBrush}" Margin="12,18" Visibility="{Binding NoProgramSearchResults, Converter={StaticResource BoolVisibility}}"/></Grid>
       </Grid>
       <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" AutomationProperties.Name="프로그램과 상세 너비 조절"/>
       <Border x:Name="ProgramInspector" Grid.Column="2" Background="{DynamicResource CardFace}" BorderBrush="{DynamicResource RimBrush}" BorderThickness="1" CornerRadius="14" Padding="20">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition x:Name="InspectorMetadataRow" Height="*" MinHeight="0"/></Grid.RowDefinitions>
         <StackPanel Grid.Row="1"><TextBlock x:Name="InspectorType" Text="{Binding SelectedProgram.KindLabel, TargetNullValue=프로그램 · 자료}" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="InspectorTitle" Text="{Binding SelectedProgram.DisplayName, TargetNullValue=목록에서 선택하세요}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip="{Binding SelectedProgram.DisplayName}" Margin="0,7,0,0"/><services:StatusBadge x:Name="InspectorStatus" Value="{Binding SelectedProgram.StatusLabel}" HorizontalAlignment="Left" Margin="0,8,0,0"/></StackPanel>
         <ScrollViewer x:Name="InspectorMetadata" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,16,0,14"><StackPanel><TextBlock Text="선택한 항목" Style="{StaticResource Eyebrow}" Margin="0,0,0,7"/><TextBlock Text="{Binding SelectedProgram.Description}" TextWrapping="Wrap" FontSize="14" LineHeight="22"/><Expander Header="파일 위치" IsExpanded="False" Margin="0,12,0,0"><TextBlock Text="{Binding SelectedProgram.Path}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/></Expander></StackPanel></ScrollViewer>
         <StackPanel x:Name="InspectorActions" Grid.Row="0" Margin="0,0,0,12"><TextBlock x:Name="InspectorActionLabel" Visibility="{Binding HasSelectedCommands, Converter={StaticResource BoolVisibility}}" Text="작업 선택" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/><ComboBox x:Name="CommandSelector" ItemsSource="{Binding SelectedProgram.Commands}" SelectedItem="{Binding SelectedCommand, Mode=TwoWay}" IsEnabled="{Binding CanLaunchSelectedProgram}" Visibility="{Binding HasSelectedCommands, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="실행할 작업" Margin="0,0,0,8"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button x:Name="LaunchProgramButton" Visibility="{Binding ShowSeparateOpenButton, Converter={StaticResource BoolVisibility}}" Content="{Binding SelectedProgram.ActionLabel, TargetNullValue=작업 실행}" Click="LaunchProgram_Click" IsEnabled="{Binding CanLaunchSelectedProgram}" Style="{StaticResource PrimaryButton}" HorizontalContentAlignment="Center" AutomationProperties.Name="선택한 작업 실행"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="OpenProgramButton" Content="{Binding SelectedProgram.OpenActionLabel}" Click="OpenProgram_Click" IsEnabled="{Binding CanOpenSelectedProgram}"  AutomationProperties.Name="선택한 파일 또는 폴더 보기"/><Button x:Name="StopProgramButton" Grid.Column="2" Content="중지" Click="StopProgram_Click" Visibility="{Binding HasSelectedCommands, Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding CanStopSelectedProgram}" AutomationProperties.Name="실행 중인 작업 중지"/></Grid></StackPanel>
        </Grid>
       </Border>
      </Grid>
      <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" AutomationProperties.Name="프로그램과 작업 기록 높이 조절" IsEnabled="{Binding IsExpanded,ElementName=LogExpander}"/>
      <Border x:Name="LogPanel" Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"><Expander x:Name="LogExpander" Header="작업 기록" IsExpanded="False" Expanded="Log_Expanded" Collapsed="Log_Collapsed"><Expander.Template><ControlTemplate TargetType="Expander"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><ToggleButton Content="{TemplateBinding Header}" IsChecked="{Binding IsExpanded,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" HorizontalContentAlignment="Left"/><ContentPresenter x:Name="LogBody" Grid.Row="1" Content="{TemplateBinding Content}" Visibility="Collapsed" Margin="0,6,0,0"/></Grid><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="LogBody" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Expander.Template><ListBox x:Name="JobLogList" ItemsSource="{Binding JobLogs}" MinHeight="30" FontSize="12" Padding="0" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0,3"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle></ListBox></Expander></Border>
       </Grid></TabItem>
       <TabItem x:Name="ProjectActivityTab" Header="작업·세션"><views:ProjectActivityView DataContext="{Binding WorkDashboard}"/></TabItem>
      </TabControl>
     </Grid>
    </Grid>
   </TabItem>
   <TabItem Header="작업 목록" x:Name="WorkDashboardTab"><views:WorkDashboardView DataContext="{Binding WorkDashboard}"/></TabItem>
   <TabItem Header="단계 현황" x:Name="ManagementProcessTab"><views:WorkDashboardView DataContext="{Binding ManagementDashboard}"/></TabItem>
   <TabItem Header="PC 연결" x:Name="PcConnectionTab"><Grid Margin="0,14,0,0" DataContext="{Binding PcConnection}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource RimBrush}" BorderThickness="1" CornerRadius="14" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><DockPanel><services:IdentityIcon Identity="ProjectBridge" Width="42" Height="42" Margin="0,0,12,0"/><StackPanel><TextBlock Text="모든 도구가 함께 쓰는 PC 연결" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding DeviceLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/></StackPanel></DockPanel><TextBlock Text="{Binding DetailText}" TextWrapping="Wrap" MaxHeight="42" TextTrimming="CharacterEllipsis" ToolTip="{Binding DetailText}" LineHeight="21" Margin="0,10,0,0" FontSize="13"/></StackPanel><StackPanel Grid.Column="1" Margin="20,0,0,0" MaxWidth="300"><services:StatusBadge Value="{Binding StatusText}" HasError="{Binding HasError}"/><TextBlock Text="{Binding RelayStatusText}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Grid></Border>
    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource RimBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,12,0,0"><StackPanel>
     <TextBlock Text="{Binding BridgeStatusText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding CommanderStatusText}" TextWrapping="Wrap" Margin="0,7,0,0"/>
     <TextBlock Text="{Binding CommanderRecoveryText}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
     <TextBlock Text="{Binding PrimaryPathText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,9,0,0"/>
    </StackPanel></Border>
    <WrapPanel Grid.Row="2" Margin="0,12,0,14"><Button Content="PC 연결 시작" Command="{Binding ConnectCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/><Button Content="새 작업 일시정지" Command="{Binding PauseCommand}" Margin="0,0,8,0"/><Button Content="PC 연결 끄기" Command="{Binding StopCommand}" Margin="0,0,8,0"/><Button Content="설치·복구" Command="{Binding InstallCommand}" Margin="0,0,8,0"/><Button Content="사용 안내" Command="{Binding OpenGuideCommand}" Margin="0,0,16,0"/><TextBlock Text="{Binding ParallelLimit,StringFormat=동시 작업 최대 {0}개}" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="12"/></WrapPanel>
    <ContentControl Grid.Row="3" x:Name="PcJobsHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
   </Grid></TabItem>
   <TabItem Header="소통방" x:Name="CommunicationTab"><views:CommunicationWorkspaceView DataContext="{Binding Communication}"/></TabItem>
   <TabItem Header="공지사항" x:Name="NoticeTab"><views:NoticeOverviewView DataContext="{Binding Communication}"/></TabItem>
   <TabItem Header="안내·기록 읽기" x:Name="DocumentReaderTab"><views:DocumentReaderView DataContext="{Binding Documents}"/></TabItem>
   <TabItem Header="도구·연결" x:Name="ToolsTab">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,18,0,0">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="도구·연결" ToolTip="원격 연결, AI 작업, 자동화와 제작 도구를 한곳에서 찾습니다." FontSize="26" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Jev 작업" Click="Jev_Click" IsEnabled="{Binding CanRunRegisteredTasks}" Style="{StaticResource QuietButton}"/></StackPanel></Grid>
     <ItemsControl x:Name="ToolCards" ItemsSource="{Binding FilteredToolStatuses}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><services:ResponsiveCardPanel MinimumCardWidth="400" Gap="12"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,4,12"><StackPanel>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><DockPanel Margin="0,0,12,0"><services:IdentityIcon Identity="{Binding RawName}" Margin="0,0,12,0"/><TextBlock Text="{Binding DisplayName}" ToolTip="{Binding Purpose}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel><services:StatusBadge Grid.Column="1" Value="{Binding StateLabel}" VerticalAlignment="Top" Margin="0,4,0,0"/></Grid>
       <TextBlock Text="{Binding UsageEvidence}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,10"/>
       <Button Content="{Binding ActionLabel}" Click="OpenTool_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" AutomationProperties.Name="{Binding DisplayName}"/>
       <Expander Header="설치·연결 확인 결과" IsExpanded="False" Margin="0,8,0,0"><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12"/></Expander>
      </StackPanel></Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <Expander Header="프로젝트 폴더·앱 관리" IsExpanded="False" Margin="0,12,0,0"><StackPanel>
      <TextBlock Text="프로젝트를 모아 둔 폴더" FontWeight="SemiBold" Margin="0,0,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding RootPath,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="프로젝트 상위 폴더"/><Button Grid.Column="1" Content="폴더 선택" Click="ChooseRoot_Click" Margin="10,0,0,0"/></Grid>
      <WrapPanel Margin="0,14,0,0"><Button Content="원격 연결 켜기" Click="EnsureRemote_Click" IsEnabled="{Binding CanMutate}" Margin="0,0,8,8"/><Button Content="원격 연결 끄기" Click="StopRemote_Click" IsEnabled="{Binding CanMutate}" Margin="0,0,8,8"/><Button Content="자동 시작 정리" Click="ConsolidateRemote_Click" IsEnabled="{Binding CanMutate}" Margin="0,0,8,8"/><Button Content="설치·자동 시작" Click="Install_Click" IsEnabled="{Binding CanMutate}" Margin="0,0,8,8"/><Button Content="자동 시작 복구" Click="Restore_Click" IsEnabled="{Binding CanMutate}" Margin="0,0,8,8"/><Button Content="앱 제거" Click="Uninstall_Click" IsEnabled="{Binding CanMutate}" Margin="0,0,8,8"/></WrapPanel>
      <CheckBox Content="화면 효과 줄이기" IsChecked="{Binding ReduceMotion,Mode=TwoWay}"/>
     </StackPanel></Expander>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem x:Name="ServerTab" Header="멀티의 신 서버">
    <Grid Margin="0,22,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="ServerHeading" Text="멀티의 신 서버" FontSize="28" FontWeight="SemiBold"/>
      <TextBlock Grid.Column="1" Text="접속 상태 자동 확인" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
     </Grid>
     <Border Grid.Row="1" Background="{DynamicResource CardFace}" BorderBrush="{DynamicResource RimBrush}" BorderThickness="1" CornerRadius="14" Padding="16,12" Margin="0,0,0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="RosterSpinner" Text="&#xE895;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource AccentBrush}" Margin="0,0,12,0" VerticalAlignment="Center" services:RefreshMotion.Active="{Binding IsUpdatingRoster}" services:RefreshMotion.DurationMilliseconds="{Binding RefreshTurnMilliseconds}" services:RefreshMotion.ReduceMotion="{Binding ReduceMotion}" AutomationProperties.Name="접속자 갱신 표시"/>
      <TextBlock Grid.Column="1" Text="{Binding RosterStatus}" VerticalAlignment="Center" TextWrapping="Wrap"/><TextBlock Grid.Column="2" Text="{Binding RosterCheckedAt}" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
     </Grid></Border>
     <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="접속 중인 사람" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,14"/>
       <Grid Grid.Row="1"><ScrollViewer x:Name="ServerModePanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding ServerPlayers}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource CardFace}" BorderBrush="{DynamicResource RimBrush}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="2,2,6,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Nickname}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Nickname}"/><TextBlock Text="{Binding GuildLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"><Border Background="{DynamicResource SelectionFace}" CornerRadius="9" Padding="10,7"><TextBlock Text="{Binding StatusLabel}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="190"/></Border><TextBlock Text="{Binding ElapsedLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="12" HorizontalAlignment="Right" Margin="0,5,2,0"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><TextBlock Text="현재 접속 중인 사람이 없습니다." Foreground="{DynamicResource MutedBrush}" Margin="14,20" Visibility="{Binding RosterEmpty, Converter={StaticResource BoolVisibility}}"/></Grid>
      </Grid>
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel>
       <TextBlock Text="서버 연결" FontSize="17" FontWeight="SemiBold"/><WrapPanel Margin="0,14,0,0"><Button Content="서버 사용 안내" Click="OpenServerGuide_Click" Margin="0,0,8,8"/><Button Content="실행 폴더 보기" Click="OpenServerFolder_Click" Margin="0,0,8,8"/><Button Content="소통 폴더 보기" Click="OpenServerMailbox_Click" Margin="0,0,8,8"/></WrapPanel>
       <TextBlock Text="{Binding ServerSummaryMessage}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,18"/>
       <TextBlock Text="GitHub 저장소" FontSize="17" FontWeight="SemiBold"/><WrapPanel Margin="0,14,0,6"><Button Content="개발 코드" Click="OpenServerSource_Click" Margin="0,0,8,8"/><Button Content="배포·설치파일" Click="OpenServerRelease_Click" Margin="0,0,8,8"/></WrapPanel><TextBlock Text="게임 수정은 개발 코드에서, 사용 버전은 배포 저장소에서 확인합니다." Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,18"/>
       <Expander Header="업데이트·접속 정책" IsExpanded="False"><StackPanel><TextBlock Text="서버가 안내하는 업데이트" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding ServerUpdatePolicy}" Margin="0,6,0,12"/><TextBlock Text="{Binding ServerMinimumBuild}"/><TextBlock Text="{Binding ServerBlockedBuilds}" Margin="0,6,0,0"/><TextBlock Text="{Binding ServerPolicyHealth}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,8,0,0"/><TextBlock Text="최신 설치파일 버전과 서버의 업데이트 정책은 다를 수 있습니다." Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Expander>
       <Expander Header="연결 위치·관리 동작" IsExpanded="False"><StackPanel><TextBlock Text="{Binding ServerRootPath}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/><Button Content="서버 폴더 변경" Click="LinkServerFolder_Click" IsEnabled="{Binding CanMutate}" HorizontalAlignment="Left"/><TextBlock Text="기존 관리창은 이전 서버 버전을 가리킵니다. 시작·종료·재시작은 실행 중인 버전과 연결을 맞춘 뒤 제공됩니다." Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Expander>
      </StackPanel></ScrollViewer>
     </Grid>
    </Grid>
   </TabItem>
   <TabControl.Template>
    <ControlTemplate TargetType="TabControl">
     <Grid SnapsToDevicePixels="True" UseLayoutRounding="True"><Grid.ColumnDefinitions><ColumnDefinition Width="182"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border x:Name="WorkspaceHeaderBar" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="8,14">
       <DockPanel><TextBlock DockPanel.Dock="Top" Text="작업 메뉴" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="8,0,8,12"/>
        <ScrollViewer x:Name="TabHeaderScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" CanContentScroll="False"><TabPanel x:Name="HeaderPanel" IsItemsHost="True" SnapsToDevicePixels="True" UseLayoutRounding="True"/></ScrollViewer>
       </DockPanel>
      </Border>
      <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="2" TextElement.Foreground="{DynamicResource TextBrush}" TextElement.FontWeight="Normal" ContentSource="SelectedContent"/>
     </Grid>
    </ControlTemplate>
   </TabControl.Template>
  </TabControl>
 </Grid>
</Window>

