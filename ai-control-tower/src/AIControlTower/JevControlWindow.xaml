<Window x:Class="AIControlTower.JevControlWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Control Tower · Jev 작업" Width="720" Height="660" MinWidth="600" MinHeight="600" WindowStartupLocation="CenterOwner">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="JEV / WORK SESSION" Style="{StaticResource Eyebrow}" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="프로젝트에 작업 전달" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="작업 위치와 지시를 확인한 뒤 실행하세요." Foreground="{StaticResource MutedBrush}" Margin="0,9,0,22"/></StackPanel>
  <StackPanel Grid.Row="1"><TextBlock Text="프로젝트 경로" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/><TextBox Text="{Binding ProjectPath, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas, Malgun Gothic" FontSize="12" AutomationProperties.Name="Jev 프로젝트 경로"/><CheckBox Content="이 작업실에서 Jev 실행 사용" IsChecked="{Binding EnableJev, Mode=TwoWay}" Margin="0,12,0,0"/><TextBlock Text="작업 내용" Style="{StaticResource Eyebrow}" Margin="0,18,0,8"/></StackPanel>
  <TextBox Grid.Row="2" Text="{Binding TaskInput, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Padding="14" AutomationProperties.Name="Jev 작업 지시"/>
  <Grid Grid.Row="3" Margin="0,18,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding ActivitySummary}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="취소" Click="CancelJev_Click" Style="{StaticResource QuietButton}" Margin="0,0,8,0"/><Button Content="Jev 작업 실행" IsEnabled="{Binding IsLocalJevExecutionAllowed}" Click="RunJev_Click" Style="{StaticResource PrimaryButton}"/></StackPanel></Grid>
  <Border Grid.Row="4" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0"><TextBlock Text="{Binding LocalJevPolicyMessage}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/></Border>
  <TextBlock Grid.Row="5" Text="{Binding Message}" Foreground="{StaticResource AccentBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>
 </Grid>
</Window>
