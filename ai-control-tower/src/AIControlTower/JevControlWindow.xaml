<Window x:Class="AIControlTower.JevControlWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="AI 작업 전달" Width="720" Height="700" MinWidth="600" MinHeight="600" WindowStartupLocation="CenterOwner">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="AI 작업 전달" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="선택한 프로젝트에서 할 일을 적어 작업을 전달합니다." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,9,0,22"/></StackPanel>
  <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,20"><StackPanel><TextBlock Text="{Binding SelectedProject.DisplayName, TargetNullValue=작업할 프로젝트}" FontWeight="SemiBold" FontSize="17"/><Expander Header="작업 폴더 확인" IsExpanded="False" Margin="0,4,0,0"><TextBox Text="{Binding ProjectPath, UpdateSourceTrigger=PropertyChanged}" FontSize="12" AutomationProperties.Name="작업 폴더"/></Expander><CheckBox Content="Jev로 작업 전달 사용" IsChecked="{Binding EnableJev, Mode=TwoWay}" Margin="0,8,0,0"/></StackPanel></Border>
  <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="어떤 일을 할까요?" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBox Grid.Row="1" Text="{Binding TaskInput, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Padding="14" AutomationProperties.Name="할 일"/></Grid>
  <Grid Grid.Row="3" Margin="0,20,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding ActivitySummary}" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="작업 중지" Click="CancelJev_Click" Style="{StaticResource QuietButton}" Margin="0,0,8,0"/><Button Content="작업 전달" IsEnabled="{Binding IsLocalJevExecutionAllowed}" Click="RunJev_Click" Style="{StaticResource PrimaryButton}"/></StackPanel></Grid>
  <StackPanel Grid.Row="4"><TextBlock Text="{Binding LocalJevPolicyMessage}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/><TextBlock Text="{Binding Message}" Foreground="{DynamicResource AccentBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel>
 </Grid>
</Window>
