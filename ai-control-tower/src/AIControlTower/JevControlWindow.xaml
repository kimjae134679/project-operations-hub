<Window x:Class="AIControlTower.JevControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jev 작업 제어" Height="560" Width="640"
        MinHeight="460" MinWidth="540"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Jev 작업 제어" FontSize="22" FontWeight="SemiBold" />

        <StackPanel Grid.Row="1" Margin="0,20,0,0">
            <TextBlock Text="프로젝트 경로" FontWeight="SemiBold" />
            <TextBox Text="{Binding ProjectPath, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="작업 내용" FontWeight="SemiBold" />
            <TextBox Text="{Binding TaskInput, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     Height="120" VerticalScrollBarVisibility="Auto" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Jev 작업 실행"
                    IsEnabled="{Binding IsLocalJevExecutionAllowed}"
                    Click="RunJev_Click" />
            <Button Content="작업 취소" Click="CancelJev_Click" Margin="8,0,0,0" />
        </StackPanel>

        <Border Grid.Row="3" Margin="0,16,0,0" Padding="12" Background="#FFF4E5" CornerRadius="6">
            <TextBlock Text="{Binding LocalJevPolicyMessage}" TextWrapping="Wrap" />
        </Border>

        <StackPanel Grid.Row="4" Margin="0,16,0,0">
            <TextBlock Text="실행 상태" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ActivitySummary}" Margin="0,4,0,0" />
        </StackPanel>

        <TextBlock Grid.Row="5" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,16,0,0" />
    </Grid>
</Window>
