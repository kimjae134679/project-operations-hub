<Window x:Class="AIControlTower.NoticeReceiptsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:services="clr-namespace:AIControlTower.Services" Style="{StaticResource {x:Type Window}}" Title="공지 확인 현황" Width="1080" Height="720" MinWidth="760" MinHeight="500" WindowStartupLocation="CenterOwner">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="누가 확인했나요?" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedNotice.Title}" FontSize="15" TextWrapping="Wrap" Margin="0,7,0,0"/><TextBlock Text="{Binding SelectedNoticeSummary}" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/></StackPanel>
  <Grid Grid.Row="1" Margin="0,20,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><Grid><TextBox Text="{Binding NoticeReceiptSearch,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="프로젝트 또는 담당자 찾기"/><TextBlock Text="프로젝트 또는 담당자 찾기" Foreground="{DynamicResource MutedBrush}" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding NoticeReceiptSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><ComboBox Grid.Column="2" ItemsSource="{Binding NoticeReceiptFilters}" SelectedItem="{Binding NoticeReceiptFilter,Mode=TwoWay}" AutomationProperties.Name="확인 상태 필터"/></Grid>
  <ListBox Grid.Row="2" x:Name="ReceiptTiles" ItemsSource="{Binding SelectedNoticeReceipts}" ScrollViewer.CanContentScroll="False"><ListBox.ItemsPanel><ItemsPanelTemplate><services:ResponsiveCardPanel MinimumCardWidth="310" Gap="12"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,0,2,10"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Actor}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,12,0"/><services:StatusBadge Grid.Column="1" Value="{Binding State}"/></Grid><TextBlock Text="{Binding Project}" FontSize="14" Margin="0,10,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding CheckedAt}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/><TextBlock Text="{Binding Note}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="20" FontSize="12" Margin="0,10,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
  <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="AI가 남긴 공지 확인 기록입니다. 소통방의 내가 읽음과 별개입니다." Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/><Button Grid.Column="1" Content="닫기" IsCancel="True" Click="Close_Click" MinWidth="100"/></Grid>
 </Grid>
</Window>
