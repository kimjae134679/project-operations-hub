   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Grid x:Name="Card"><Border x:Name="Row" Background="{DynamicResource CardFace}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10"><Grid><ContentPresenter Margin="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}"/></Grid></Border></Grid>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectionFace}"/><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/><Setter TargetName="Row" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Expander"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="IsExpanded" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel>
    <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Foreground="{DynamicResource TextBrush}" Padding="2,12,2,12" HorizontalContentAlignment="Stretch"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="GroupHead" Background="{DynamicResource RaisedBrush}" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path x:Name="Chevron" Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8" VerticalAlignment="Center" Margin="5,0,0,0"/><ContentPresenter Grid.Column="1" TextElement.Foreground="{TemplateBinding Foreground}"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="False"><Setter TargetName="Chevron" Property="Data" Value="M 0 0 L 4 4 L 0 8"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="GroupHead" Property="BorderBrush" Value="{DynamicResource LineBrush}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="GroupHead" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/><Setter TargetName="GroupHead" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template><ContentPresenter Content="{TemplateBinding Header}"/></ToggleButton>
    <ContentPresenter x:Name="Body" Visibility="Collapsed" Margin="0,9,0,4"/>
   </StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="GridSplitter"><Setter Property="Background" Value="{DynamicResource LineBrush}"/><Setter Property="ShowsPreview" Value="True"/><Setter Property="ResizeBehavior" Value="PreviousAndNext"/><Setter Property="Focusable" Value="True"/><Setter Property="MinWidth" Value="5"/><Setter Property="MinHeight" Value="5"/></Style>
  <Style TargetType="TabControl"><Setter Property="TabStripPlacement" Value="Top"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="6" Margin="0,0,0,8"><ScrollViewer x:Name="TabHeaderScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="False"><TabPanel x:Name="HeaderPanel" IsItemsHost="True" Margin="2,0,6,0"/></ScrollViewer></Border><ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" TextElement.Foreground="{DynamicResource TextBrush}" TextElement.FontWeight="Normal" ContentSource="SelectedContent"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TabItem">
   <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="{StaticResource ControlPadding}"/><Setter Property="MinHeight" Value="{StaticResource ControlMinHeight}"/><Setter Property="MinWidth" Value="72"/><Setter Property="Margin" Value="2,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="SnapsToDevicePixels" Value="True"/><Setter Property="UseLayoutRounding" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
    <ControlTemplate.Resources><DataTemplate DataType="{x:Type sys:String}"><AccessText Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/></DataTemplate></ControlTemplate.Resources>
    <Grid><Border x:Name="TabTile" Background="Transparent" CornerRadius="0" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True"/></Border><Border x:Name="TabFocus" BorderBrush="{DynamicResource FocusBrush}" BorderThickness="2" CornerRadius="0" Visibility="Collapsed" IsHitTestVisible="False"/></Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabTile" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabTile" Property="Background" Value="{DynamicResource SelectionBrush}"/><Setter TargetName="TabTile" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="TabFocus" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource DisabledInkBrush}"/><Setter TargetName="TabTile" Property="Background" Value="{DynamicResource DisabledBrush}"/><Setter TargetName="TabTile" Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter TargetName="TabFocus" Property="Visibility" Value="Collapsed"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Padding" Value="{StaticResource ControlPadding}"/><Setter Property="MinHeight" Value="{StaticResource ControlMinHeight}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <ControlTemplate.Resources><DataTemplate DataType="{x:Type sys:String}"><AccessText Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></ControlTemplate.Resources>
    <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border x:Name="CheckFace" Width="18" Height="18" CornerRadius="5" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource MutedBrush}" BorderThickness="1" VerticalAlignment="Center"><Path x:Name="Tick" Data="M 0 4 L 3 7 L 9 0" Stroke="{DynamicResource AccentInkBrush}" StrokeThickness="2" Margin="3" Visibility="Collapsed"/></Border>
     <Border x:Name="CheckFocus" Width="22" Height="22" CornerRadius="6" BorderBrush="{DynamicResource FocusBrush}" BorderThickness="2" Visibility="Collapsed" VerticalAlignment="Center" IsHitTestVisible="False"/>
     <ContentPresenter Grid.Column="1" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckFace" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckFace" Property="Background" Value="{DynamicResource ActionFace}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckFocus" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource DisabledInkBrush}"/><Setter TargetName="CheckFace" Property="Background" Value="{DynamicResource DisabledBrush}"/><Setter TargetName="CheckFace" Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter TargetName="Tick" Property="Stroke" Value="{DynamicResource DisabledInkBrush}"/><Setter TargetName="CheckFocus" Property="Visibility" Value="Collapsed"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource RaisedBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="{StaticResource ControlPadding}"/><Setter Property="MinHeight" Value="{StaticResource ControlMinHeight}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid>
     <Border x:Name="ComboChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource ControlCornerRadius}"/>
     <ToggleButton Focusable="False" MinHeight="0" Padding="0" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><Path x:Name="Arrow" Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5" Width="8" Height="4" HorizontalAlignment="Right" Margin="0,0,12,0"/></Border><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource DisabledInkBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
     <Grid Margin="{TemplateBinding Padding}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions><ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" VerticalAlignment="Center"><ContentPresenter.ContentTemplate><MultiBinding Converter="{StaticResource ComboSelectionTemplate}"><Binding Path="SelectionBoxItemTemplate" RelativeSource="{RelativeSource TemplatedParent}"/><Binding Path="ItemTemplate" RelativeSource="{RelativeSource TemplatedParent}"/><Binding Path="ItemTemplateSelector" RelativeSource="{RelativeSource TemplatedParent}"/><Binding Path="SelectionBoxItem" RelativeSource="{RelativeSource TemplatedParent}"/><Binding Path="SelectionBoxItemStringFormat" RelativeSource="{RelativeSource TemplatedParent}"/></MultiBinding></ContentPresenter.ContentTemplate></ContentPresenter></Grid>
     <Border x:Name="ComboFocus" BorderBrush="{DynamicResource FocusBrush}" BorderThickness="2" CornerRadius="{StaticResource ControlCornerRadius}" Visibility="Collapsed" IsHitTestVisible="False"/>
     <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"><Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="{StaticResource ControlCornerRadius}" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="300"><ItemsPresenter/></ScrollViewer></Border></Popup>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboChrome" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboFocus" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="ComboChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource DisabledInkBrush}"/><Setter TargetName="ComboChrome" Property="Background" Value="{DynamicResource DisabledBrush}"/><Setter TargetName="ComboChrome" Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter TargetName="ComboFocus" Property="Visibility" Value="Collapsed"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Padding" Value="12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Option" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Option" Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ToolTip"><Setter Property="Background" Value="{DynamicResource RaisedBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="Padding" Value="10"/></Style>
  <Style TargetType="ScrollBar"><Setter Property="Background" Value="Transparent"/><Setter Property="Width" Value="11"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}"><Track.DecreaseRepeatButton><RepeatButton x:Name="PageDecrease" Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource ScrollThumbBrush}" CornerRadius="4" Margin="2,0"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton x:Name="PageIncrease" Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Height" Value="11"/><Setter Property="Width" Value="Auto"/><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="PageDecrease" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/><Setter TargetName="PageIncrease" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="RichTextBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/></Style>

 </Application.Resources>
</Application>
