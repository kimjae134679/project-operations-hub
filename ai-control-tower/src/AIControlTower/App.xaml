   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ButtonBase">
    <ControlTemplate.Resources><DataTemplate DataType="{x:Type sys:String}"><AccessText Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/></DataTemplate></ControlTemplate.Resources>
