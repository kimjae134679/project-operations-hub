     <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource ControlCornerRadius}">
      <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="True"/>
     </Border>
     <Border x:Name="PressedOutline" CornerRadius="8" BorderBrush="{DynamicResource FocusBrush}" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False"/>
     <Border x:Name="FocusRing" CornerRadius="{StaticResource ControlCornerRadius}" BorderBrush="{TemplateBinding Foreground}" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="PressedOutline" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource DisabledInkBrush}"/><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource DisabledBrush}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter TargetName="FocusRing" Property="Visibility" Value="Collapsed"/><Setter TargetName="PressedOutline" Property="Visibility" Value="Collapsed"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource ButtonPressedBrush}"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource ActionControlStyle}"/>
