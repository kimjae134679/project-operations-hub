<UserControl x:Class="AIControlTower.Views.CommunicationWorkspaceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:services="clr-namespace:AIControlTower.Services" AutomationProperties.Name="프로젝트 주제와 게시글 댓글 읽기">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="VisibleIf"/></UserControl.Resources>
 <Grid Margin="0,12,0,0">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,8"><TextBlock Text="{Binding CommunicationMessage}" TextWrapping="Wrap"/><TextBlock Text="{Binding CentralSyncMessage}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding CommunicationCheckedAt}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
  <Grid Grid.Row="1" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
   <ComboBox ItemsSource="{Binding InboxProjectFilters}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding InboxProjectFilterId}" AutomationProperties.Name="전체 또는 특정 프로젝트 즉시 필터"/>
   <TextBox Grid.Column="1" Margin="8,0" Text="{Binding CommunicationSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="주제와 본문 검색" AutomationProperties.Name="소통 자료 검색"/>
   <ComboBox Grid.Column="2" ItemsSource="{Binding CommunicationStateFilters}" SelectedItem="{Binding CommunicationStateFilter}" AutomationProperties.Name="소통 상태 필터"/>
  </Grid>
  <DockPanel Grid.Row="2" Margin="0,0,0,8"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><CheckBox Content="안 읽은 자료만" IsChecked="{Binding OnlyUnread}"/><CheckBox Content="수정 이력 포함" IsChecked="{Binding ShowCommunicationHistory}"/></StackPanel><TextBlock Text="{Binding InboxCountLabel}" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
  <Grid Grid.Row="3">
   <Grid.ColumnDefinitions><ColumnDefinition Width="280" MinWidth="180"/><ColumnDefinition Width="8"/><ColumnDefinition Width="230" MinWidth="150"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*" MinWidth="260"/></Grid.ColumnDefinitions>
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="1. 주제 / 전달 자료" FontWeight="SemiBold" FontSize="15" Margin="8,0,0,8"/>
    <ListBox x:Name="InboxList" Grid.Row="1" ItemsSource="{Binding InboxItems}" SelectedItem="{Binding SelectedInbox}" AutomationProperties.Name="프로젝트 주제 목록">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding AutomationLabel}"/><Setter Property="Padding" Value="12"/></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Project}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="15" Margin="0,5,0,0"/><TextBlock Text="{Binding ConversationSummary}" TextWrapping="Wrap" Margin="0,7,0,0"/><TextBlock Text="{Binding Author}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock Text="{Binding StateLabel}" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock Text="{Binding UnreadLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <TextBlock Grid.Row="1" Text="{Binding InboxEmptyLabel}" Margin="12" TextWrapping="Wrap" Visibility="{Binding NoInboxItems, Converter={StaticResource VisibleIf}}" IsHitTestVisible="False"/>
    <StackPanel Grid.Row="2" Orientation="Horizontal"><Button Content="이전 자료" Command="{Binding PreviousPostCommand}" Style="{StaticResource QuietButton}"/><Button Content="다음 자료" Command="{Binding NextPostCommand}" Style="{StaticResource QuietButton}" Margin="8,0,0,0"/></StackPanel>
   </Grid>
   <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource LineBrush}" AutomationProperties.Name="주제 목록 너비 조절"/>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="2. 게시글 / 댓글" FontWeight="SemiBold" FontSize="15" Margin="8,0,0,8"/>
    <ListBox x:Name="EntryList" Grid.Row="1" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" AutomationProperties.Name="선택 주제의 개별 게시글과 댓글">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding AutomationLabel}"/><Setter Property="Padding" Value="10"/></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding KindLabel}" Foreground="{DynamicResource AccentBrush}" FontSize="12"/><TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="{Binding Author}" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock Text="{Binding TimeDisplay}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/><TextBlock Text="{Binding UnreadLabel}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="2"><TextBlock Text="{Binding EntryPositionLabel}" HorizontalAlignment="Center" Margin="0,4"/><StackPanel Orientation="Horizontal"><Button Content="이전 글" Command="{Binding PrevEntryCommand}" Style="{StaticResource QuietButton}"/><Button Content="다음 글" Command="{Binding NextEntryCommand}" Style="{StaticResource QuietButton}" Margin="8,0,0,0"/></StackPanel></StackPanel>
   </Grid>
   <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource LineBrush}" AutomationProperties.Name="게시글 목록과 본문 너비 조절"/>
   <Grid Grid.Column="4" Margin="14,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,10"><TextBlock Text="{Binding SelectedThreadHeader}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="12"/><TextBlock Text="{Binding SelectedEntry.Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,0"/><WrapPanel Margin="0,6,0,0"><TextBlock Text="{Binding SelectedEntry.KindLabel}" Margin="0,0,12,0"/><TextBlock Text="{Binding SelectedEntry.Author}" Margin="0,0,12,0"/><TextBlock Text="{Binding SelectedEntry.TimeDisplay}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,12,0"/><TextBlock Text="{Binding SelectedEntry.UnreadLabel}"/></WrapPanel><TextBlock Text="{Binding SelectedInbox.StateLabel}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
    <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12"><RichTextBox x:Name="ArticleReader" IsReadOnly="True" FontSize="15" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" services:NoticeDocument.Text="{Binding SelectedBody}" services:NoticeDocument.BaseDirectory="{Binding CommunicationHubPath}" AutomationProperties.Name="선택 게시글 또는 댓글 본문"/></Border>
    <DockPanel Grid.Row="2" Margin="0,8,0,0"><Button DockPanel.Dock="Right" Content="수집 파일 위치" Click="OpenCollectedFile_Click" Style="{StaticResource QuietButton}"/><TextBlock Text="{Binding UserReadExplanation}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,8,0"/></DockPanel>
   </Grid>
  </Grid>
  <Expander Grid.Row="4" Header="전달 / 폴더 연결 설정 (기존 기능)" IsExpanded="False" Margin="0,8,0,0"><WrapPanel><Button Content="선택 프로젝트 폴더 연결" Click="LinkCommunicationProject_Click" IsEnabled="{Binding CanMutate}" Style="{StaticResource QuietButton}"/><Button Content="소통 폴더 열기" Click="OpenCommunicationFolder_Click" Style="{StaticResource QuietButton}" Margin="8,0"/><CheckBox IsEnabled="{Binding CanMutate}" Content="수집 자료를 GitHub에 자동 공유" IsChecked="{Binding AutoPublishCommunication}"/></WrapPanel></Expander>
 </Grid>
</UserControl>
