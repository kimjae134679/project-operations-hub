<UserControl x:Class="AIControlTower.Views.CommunicationWorkspaceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:services="clr-namespace:AIControlTower.Services" AutomationProperties.Name="게시글과 댓글">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="VisibleIf"/>
  <Style x:Key="ReplyBadge" TargetType="Border">
   <Setter Property="Background" Value="{DynamicResource StatusWarningFace}"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="7,4"/>
   <Style.Triggers><DataTrigger Binding="{Binding ReplyStatusKey}" Value="Complete"><Setter Property="Background" Value="{DynamicResource StatusSuccessFace}"/></DataTrigger><DataTrigger Binding="{Binding ReplyStatusKey}" Value="Answered"><Setter Property="Background" Value="{DynamicResource StatusRunningFace}"/></DataTrigger><DataTrigger Binding="{Binding ReplyStatusKey}" Value="Blocked"><Setter Property="Background" Value="{DynamicResource StatusErrorFace}"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="ReplyBadgeText" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{DynamicResource StatusWarningInk}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Style.Triggers><DataTrigger Binding="{Binding ReplyStatusKey}" Value="Complete"><Setter Property="Foreground" Value="{DynamicResource StatusSuccessInk}"/></DataTrigger><DataTrigger Binding="{Binding ReplyStatusKey}" Value="Answered"><Setter Property="Foreground" Value="{DynamicResource StatusRunningInk}"/></DataTrigger><DataTrigger Binding="{Binding ReplyStatusKey}" Value="Blocked"><Setter Property="Foreground" Value="{DynamicResource StatusErrorInk}"/></DataTrigger></Style.Triggers>
  </Style>
 </UserControl.Resources>
 <Grid Margin="0,12,0,0">
  <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="180"/><ColumnDefinition Width="8"/><ColumnDefinition Width="5*" MinWidth="260"/></Grid.ColumnDefinitions>
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <StackPanel Margin="8,0,0,10"><TextBlock Text="게시글" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding CommunityListSummary}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
   <ListBox x:Name="InboxList" Grid.Row="1" ItemsSource="{Binding InboxItems}" SelectedItem="{Binding SelectedInbox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="게시글 목록">
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding AutomationLabel}"/><Setter Property="Padding" Value="12"/></Style></ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate><DataTemplate><StackPanel>
     <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="15"/>
     <TextBlock Text="{Binding CountLabel}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,7,0,0"/>
     <TextBlock Text="{Binding ExtraCountLabel}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
     <Border Style="{StaticResource ReplyBadge}" Margin="0,7,0,0" HorizontalAlignment="Left"><TextBlock Text="{Binding ReplyStateLabel}" Style="{StaticResource ReplyBadgeText}"/></Border>
     <WrapPanel Margin="0,7,0,0"><TextBlock Text="{Binding UnreadLabel}" FontSize="12" Margin="0,0,8,0"/><Border Background="{DynamicResource StatusRunningFace}" CornerRadius="5" Padding="5,2" Visibility="{Binding HasNewComments, Converter={StaticResource VisibleIf}}"><TextBlock Text="{Binding NewCommentLabel}" Foreground="{DynamicResource StatusRunningInk}" FontWeight="SemiBold" FontSize="12"/></Border></WrapPanel>
     <TextBlock Text="{Binding Author}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock Text="{Binding CommunityTimeDisplay}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
    </StackPanel></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <TextBlock Grid.Row="1" Text="{Binding InboxEmptyLabel}" Margin="12" TextWrapping="Wrap" Visibility="{Binding NoInboxItems, Converter={StaticResource VisibleIf}}" IsHitTestVisible="False"/>
  </Grid>
  <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource LineBrush}" AutomationProperties.Name="게시글 목록 너비 조절"/>
  <Grid Grid.Column="2" Margin="14,0,0,0"><Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="3*" MinHeight="80"/>
   <RowDefinition><RowDefinition.Style><Style TargetType="RowDefinition"><Setter Property="Height" Value="8"/><Style.Triggers><DataTrigger Binding="{Binding ShowCommunicationRaw}" Value="False"><Setter Property="Height" Value="0"/></DataTrigger></Style.Triggers></Style></RowDefinition.Style></RowDefinition>
   <RowDefinition><RowDefinition.Style><Style TargetType="RowDefinition"><Setter Property="Height" Value="*"/><Setter Property="MinHeight" Value="80"/><Style.Triggers><DataTrigger Binding="{Binding ShowCommunicationRaw}" Value="False"><Setter Property="Height" Value="0"/><Setter Property="MinHeight" Value="0"/></DataTrigger></Style.Triggers></Style></RowDefinition.Style></RowDefinition>
   <RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Margin="0,0,0,10"><TextBlock Text="{Binding SelectedInbox.Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/><WrapPanel Margin="0,7,0,0"><TextBlock Text="{Binding CommunityAuthorLabel}" Margin="0,0,12,0"/><TextBlock Text="{Binding CommunityTimeLabel}" Foreground="{DynamicResource MutedBrush}"/></WrapPanel></StackPanel>
   <ScrollViewer x:Name="ArticleReader" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="선택 게시글과 모든 댓글">
    <StackPanel>
     <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12"><RichTextBox x:Name="PostBody" IsReadOnly="True" FontSize="15" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" services:NoticeDocument.Text="{Binding SelectedCommunityBody}" services:NoticeDocument.BaseDirectory="{Binding CommunicationHubPath}" AutomationProperties.Name="게시글 본문"/></Border>
     <TextBlock Text="{Binding CommunityCommentCountLabel}" FontWeight="SemiBold" FontSize="15" Margin="0,16,0,8"/>
     <ItemsControl x:Name="CommentsList" ItemsSource="{Binding CommunityComments}" AutomationProperties.Name="게시글의 모든 댓글">
      <ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8"><StackPanel>
       <WrapPanel><TextBlock Text="{Binding Author}" FontWeight="SemiBold" Margin="0,0,12,0"/><TextBlock Text="{Binding TimeDisplay}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></WrapPanel>
       <WrapPanel Margin="0,6,0,0"><TextBlock Text="{Binding ReadLabel}" FontSize="12" Margin="0,4,8,0"/><Button Content="이 댓글 읽음 표시" Click="MarkCommentRead_Click" Visibility="{Binding IsUnread, Converter={StaticResource VisibleIf}}" ToolTip="이 댓글 내용의 사용자 읽기 위치만 기록합니다" AutomationProperties.Name="이 댓글 읽음 표시" Padding="6,3" FontSize="12"/></WrapPanel>
       <RichTextBox IsReadOnly="True" FontSize="15" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" services:NoticeDocument.Text="{Binding Body}" services:NoticeDocument.BaseDirectory="{Binding DataContext.CommunicationHubPath, RelativeSource={RelativeSource AncestorType=UserControl}}" AutomationProperties.Name="댓글 본문"/>
      </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </StackPanel>
   </ScrollViewer>
   <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{DynamicResource LineBrush}" Visibility="{Binding ShowCommunicationRaw, Converter={StaticResource VisibleIf}}" AutomationProperties.Name="게시글과 원문 높이 조절"/>
   <Grid Grid.Row="3" Visibility="{Binding ShowCommunicationRaw, Converter={StaticResource VisibleIf}}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="{Binding SelectedEntry.SourceName}" ToolTip="{Binding SelectedEntry.SourceLabel}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,5"/><TextBox x:Name="RawReader" Grid.Row="1" Text="{Binding SelectedRawBody, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FontSize="12" AutomationProperties.Name="원문 읽기 전용"/></Grid>
   <CheckBox Grid.Row="4" Content="원문" IsChecked="{Binding ShowCommunicationRaw}" HorizontalAlignment="Right" Margin="0,8,0,0"/>
  </Grid>
 </Grid>
</UserControl>
