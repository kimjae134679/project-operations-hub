<UserControl x:Class="AIControlTower.Views.WorkDashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:services="clr-namespace:AIControlTower.Services">
 <Grid Margin="0,16,0,0">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="{Binding Heading}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{Binding ContextMessage}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,6,14,0"/></StackPanel>
   <Button Grid.Column="1" Content="지금 조회" Click="Refresh_Click" VerticalAlignment="Center" AutomationProperties.Name="전체 작업 기록 지금 조회"/>
  </Grid>
  <Grid Grid.Row="1" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBox x:Name="WorkSearch" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" ToolTip="프로젝트 · 실행기 · 작업 · 상태로 검색" AutomationProperties.Name="프로젝트 실행기 작업 검색" VerticalContentAlignment="Center"/>
   <TextBox Grid.Column="2" Text="{Binding SourcePathInput,UpdateSourceTrigger=PropertyChanged}" ToolTip="연결할 state.json의 정확한 절대 경로" AutomationProperties.Name="연속 실행기 상태 파일 절대 경로" VerticalContentAlignment="Center"/>
   <Button Grid.Column="3" Content="상태 파일 연결" Click="Register_Click" IsEnabled="{Binding CanRegisterSource}" Margin="8,0,0,0" AutomationProperties.Name="명시한 상태 파일 연결"/>
  </Grid>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="360" MinWidth="280"/></Grid.ColumnDefinitions>
   <ListBox x:Name="WorkList" ItemsSource="{Binding FilteredActivities}" SelectedItem="{Binding Selected,Mode=TwoWay}" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="실제 작업 상태 목록" HorizontalContentAlignment="Stretch">
    <ListBox.ItemTemplate><DataTemplate><Grid Margin="4,6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,10,0"/><services:StatusBadge Grid.Column="1" Value="{Binding StatusLabel}"/></Grid>
     <WrapPanel Grid.Row="1" Margin="0,8,0,0"><TextBlock Text="{Binding Project}" FontWeight="SemiBold" Margin="0,0,14,0"/><TextBlock Text="{Binding Worker}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,14,0"/><TextBlock Text="{Binding UpdatedLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/></WrapPanel>
     <TextBlock Grid.Row="2" Text="{Binding Stage}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,6,0,0"/>
    </Grid></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
    <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock Text="{Binding Selected.Title,TargetNullValue=작업을 선택하세요}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Selected.Source}" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Selected.Evidence}" Margin="0,14,0,0" TextWrapping="Wrap" FontSize="13" LineHeight="21"/>
      <TextBlock Text="단계와 다음 체크포인트" FontWeight="SemiBold" Margin="0,18,0,6"/>
      <TextBlock Text="{Binding Selected.Stage}" TextWrapping="Wrap"/><TextBlock Text="{Binding Selected.NextCheckpoint}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/>
      <TextBlock Text="진행·검증·최근 기록" FontWeight="SemiBold" Margin="0,18,0,6"/>
      <TextBlock Text="{Binding Selected.RecentLog}" TextWrapping="Wrap"/><TextBox Text="{Binding SelectedDetails,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" Margin="0,8,0,0" AutomationProperties.Name="선택 작업 정제된 내부 기록"/>
      <TextBlock Text="{Binding Selected.Error}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0"/>
     </StackPanel></ScrollViewer>
     <StackPanel Grid.Row="1" Margin="0,18,0,0"><Button Content="정제된 상세·내부 로그 조회" Click="Details_Click" AutomationProperties.Name="선택 작업 정제된 내부 로그 조회"/><Button Content="관제탑 소유 작업만 중지" Click="Stop_Click" IsEnabled="{Binding CanStopOwned}" Margin="0,8,0,0" AutomationProperties.Name="관제탑 현재 소유 작업만 중지"/></StackPanel>
    </Grid>
   </Border>
  </Grid>
  <TextBlock Grid.Row="3" Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0" FontSize="12"/>
 </Grid>
</UserControl>
