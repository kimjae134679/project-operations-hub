<UserControl x:Class="AIControlTower.Views.NoticeOverviewView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:services="clr-namespace:AIControlTower.Services" AutomationProperties.Name="공지 본문과 실제 AI 확인 현황">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="VisibleIf"/></UserControl.Resources>
 <Grid Margin="0,12,0,0">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="280" MinWidth="200"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*" MinWidth="360"/></Grid.ColumnDefinitions>
  <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,8"><TextBlock Text="{Binding CommunicationMessage}" TextWrapping="Wrap"/><TextBlock Text="{Binding CentralSyncMessage}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/><TextBlock Text="{Binding CommunicationCheckedAt}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></StackPanel>
  <Grid Grid.Row="1">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <TextBlock Text="공지 목록" FontSize="16" FontWeight="SemiBold" Margin="8,0,0,10"/>
   <ListBox x:Name="NoticeList" Grid.Row="1" ItemsSource="{Binding Notices}" SelectedItem="{Binding SelectedNotice}" AutomationProperties.Name="공지 선택">
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding AutomationLabel}"/></Style></ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding VersionLabel}" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/><TextBlock Text="{Binding ReadSummary}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <TextBlock Grid.Row="1" Text="아직 받은 공지가 없습니다" TextWrapping="Wrap" Margin="12" Visibility="{Binding NoNotices, Converter={StaticResource VisibleIf}}" IsHitTestVisible="False"/>
  </Grid>
  <GridSplitter Grid.Row="1" Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource LineBrush}" AutomationProperties.Name="공지 목록 너비 조절"/>
  <Grid Grid.Row="1" Grid.Column="2" Margin="14,0,0,0">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="3*" MinHeight="120"/><RowDefinition Height="8"/><RowDefinition Height="2*" MinHeight="200"/></Grid.RowDefinitions>
   <StackPanel Margin="0,0,0,8"><TextBlock Text="{Binding SelectedNotice.Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedNotice.HashLabel}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
   <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
    <RichTextBox x:Name="NoticeBody" IsReadOnly="True" FontSize="15" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" services:NoticeDocument.Text="{Binding SelectedNotice.Notice.Body}" services:NoticeDocument.BaseDirectory="{Binding CommunicationHubPath}" AutomationProperties.Name="선택 공지 본문"/>
   </Border>
   <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{DynamicResource LineBrush}" AutomationProperties.Name="공지 본문과 확인 기록 높이 조절"/>
   <Grid Grid.Row="3" x:Name="ReceiptPane">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,5,0,8"><TextBlock Text="누가 읽었고 적용했나요? · 현재 버전의 실제 확인 기록" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedNoticeSummary}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
    <Grid Grid.Row="1" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding ReceiptFilters}" SelectedItem="{Binding ReceiptFilter}" AutomationProperties.Name="공지 확인 상태 필터"/><TextBox Grid.Column="1" Margin="8,0,0,0" Text="{Binding ReceiptSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="프로젝트 · AI · 세션 · 상태 · 시각 · 메모 검색" AutomationProperties.Name="확인 기록 검색"/></Grid>
    <ListBox Grid.Row="2" ItemsSource="{Binding ReceiptRows}" AutomationProperties.Name="현재 공지의 AI 본인 확인 기록과 미확인 프로젝트">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding AutomationLabel}"/><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,2,4,6"/></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Project}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Actor}" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock Text="{Binding IdentityLabel}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="{Binding State}" FontWeight="SemiBold"/><TextBlock Text="{Binding CheckedAt}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/><TextBlock Text="{Binding Note}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <TextBlock Grid.Row="2" Text="{Binding ReceiptEmptyLabel}" TextWrapping="Wrap" Margin="12" Visibility="{Binding NoReceiptRows, Converter={StaticResource VisibleIf}}" IsHitTestVisible="False"/>
    <StackPanel Grid.Row="3"><TextBlock Text="{Binding ReceiptCountLabel}" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,4"/><TextBlock Text="{Binding NoticeAudienceLabel}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></StackPanel>
   </Grid>
  </Grid>
 </Grid>
</UserControl>
