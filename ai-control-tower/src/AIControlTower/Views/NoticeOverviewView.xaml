<UserControl x:Class="AIControlTower.Views.NoticeOverviewView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:services="clr-namespace:AIControlTower.Services" AutomationProperties.Name="공지와 프로젝트 확인">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="VisibleIf"/></UserControl.Resources>
 <Grid Margin="0,12,0,0">
  <Grid.ColumnDefinitions><ColumnDefinition Width="280" MinWidth="200"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*" MinWidth="360"/></Grid.ColumnDefinitions>
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <TextBlock Text="공지" FontSize="16" FontWeight="SemiBold" Margin="8,0,0,10"/>
   <ListBox x:Name="NoticeList" Grid.Row="1" ItemsSource="{Binding Notices}" SelectedItem="{Binding SelectedNotice}" AutomationProperties.Name="공지 선택">
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding AutomationLabel}"/></Style></ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <TextBlock Grid.Row="1" Text="아직 받은 공지가 없습니다" TextWrapping="Wrap" Margin="12" Visibility="{Binding NoNotices, Converter={StaticResource VisibleIf}}" IsHitTestVisible="False"/>
  </Grid>
  <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource LineBrush}" AutomationProperties.Name="공지 목록 너비 조절"/>
  <Grid Grid.Column="2" Margin="14,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="3*" MinHeight="120"/><RowDefinition Height="8"/><RowDefinition Height="2*" MinHeight="140"/></Grid.RowDefinitions>
   <TextBlock Text="{Binding SelectedNotice.Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
   <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12"><RichTextBox x:Name="NoticeBody" IsReadOnly="True" FontSize="15" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" services:NoticeDocument.Text="{Binding SelectedNotice.Notice.Body}" services:NoticeDocument.BaseDirectory="{Binding CommunicationHubPath}" AutomationProperties.Name="선택 공지 본문"/></Border>
   <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{DynamicResource LineBrush}" AutomationProperties.Name="공지 본문과 프로젝트 목록 높이 조절"/>
   <Grid Grid.Row="3" x:Name="ReceiptPane"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,5,0,8"><TextBlock Text="{Binding CurrentProjectCheckSummary}" DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="프로젝트 확인" FontSize="16" FontWeight="SemiBold"/></DockPanel>
    <ListBox Grid.Row="1" ItemsSource="{Binding NoticeProjectRows}" AutomationProperties.Name="현재 프로젝트의 공지 확인">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding AutomationLabel}"/><Setter Property="Padding" Value="10"/></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><DockPanel><TextBlock Text="{Binding StatusLabel}" DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}" Margin="12,0,0,0"/><CheckBox IsChecked="{Binding IsChecked, Mode=OneWay}" IsEnabled="{Binding CanCheck}" IsHitTestVisible="False" Focusable="False" Content="{Binding Name}" AutomationProperties.Name="{Binding AutomationLabel}"/></DockPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </Grid>
  </Grid>
 </Grid>
</UserControl>
