{
  "schemaVersion": 1,
  "id": "my-project",
  "name": "내 프로젝트",
  "description": "기능과 실행 프로그램을 각각 등록하는 예시",
  "functions": [
    {
      "id": "application",
      "name": "사용자 앱",
      "programs": [
        {
          "id": "desktop",
          "name": "데스크톱 프로그램",
          "kind": "Windows",
          "path": "publish/MyApp.exe",
          "workingDirectory": "publish",
          "description": "실제 실행파일과 일치하도록 경로를 바꾸세요.",
          "commands": [{ "name": "실행", "fileName": "./MyApp.exe", "arguments": [], "timeoutSeconds": 0 }]
        }
      ]
    },
    {
      "id": "validation",
      "name": "프로젝트 검사",
      "programs": [
        {
          "id": "dotnet",
          "name": ".NET 빌드와 검사",
          "kind": ".NET",
          "path": ".",
          "workingDirectory": ".",
          "description": "dotnet.exe가 설치되어 있고 실제 프로젝트가 있는 경우 사용합니다.",
          "commands": [
            { "name": "빌드", "fileName": "dotnet.exe", "arguments": ["build", "--nologo"], "timeoutSeconds": 600 },
            { "name": "테스트", "fileName": "dotnet.exe", "arguments": ["test", "--nologo"], "timeoutSeconds": 600 }
          ]
        }
      ]
    }
  ]
}
